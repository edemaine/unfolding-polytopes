"civet esCompat";
import {closeSync, existsSync, fsyncSync, lstatSync, openSync, readSync, readFileSync, readdirSync, realpathSync, renameSync, unlinkSync, writeFileSync} from 'node:fs';
import {join} from 'node:path';
import {randomUUID} from 'node:crypto';
import {trialStatuses} from './jobs.civet';
import {trialJSON} from './storage.civet';

export function compactResults(paths: string[], dryRun = false, progress: (row: object) => void = () => {}) {
  const totals = {examined: 0, compacted: 0, wouldCompact: 0, alreadyConcise: 0, candidates: 0, pending: 0, invalid: 0, changedDuringRead: 0, errors: 0, savedBytes: 0};
  const seen = new Set<string>();
  const warnings: string[] = [];
  const warn = (file: string, error: unknown): void => {
    totals.errors++;
    if (warnings.length < 10) warnings.push(`${file}: ${String(error)}`);
  };
  let lastProgress = Date.now();
  function scan(directory: string): void {
    directory = realpathSync(directory);
    const key = process.platform === 'win32' ? directory.toLowerCase() : directory;
    if (seen.has(key)) return;
    seen.add(key);
    const entries = readdirSync(directory, {withFileTypes: true});
    const finished = existsSync(join(directory, 'summary.json'));
    // A writer closes the trial file before appending its journal entry.
    // Unindexed files in unfinished runs may still be open: never rewrite them.
    const {statuses} = trialStatuses(directory);
    for (const entry of entries) {
      if (Date.now() - lastProgress >= 5000) {
        progress({directory, dryRun, ...totals}); lastProgress = Date.now();
      }
      if (!entry.isFile() || !/^trial-.*\.json$/.test(entry.name)) continue;
      totals.examined++;
      if (!finished && !statuses.has(entry.name)) { totals.pending++; continue; }
      const file = join(directory, entry.name);
      let temporary: string | undefined;
      try {
        const before = lstatSync(file);
        if (!before.isFile()) continue;
        // Our concise marker is first, so repeat passes need only a tiny read.
        const fd = openSync(file, 'r');
        const prefix = Buffer.alloc(32);
        let count: number;
        try { count = readSync(fd, prefix, 0, prefix.length, 0); } finally { closeSync(fd); }
        if (prefix.subarray(0, count).toString().startsWith('{"outputDetail":"concise",')) {
          totals.alreadyConcise++; continue;
        }
        const original = readFileSync(file, 'utf8');
        let record: any;
        try { record = JSON.parse(original); } catch { totals.invalid++; continue; }
        if (record?.result?.status === 'no-unfolding') { totals.candidates++; continue; }
        if (record?.formatVersion !== 1 || !Array.isArray(record.points) ||
            !(['found', 'inconclusive'].includes(record.result?.status) || typeof record.error === 'string')) {
          totals.invalid++; continue;
        }
        const text = trialJSON(record);
        const saved = Buffer.byteLength(original) - Buffer.byteLength(text);
        if (saved <= 0) { totals.alreadyConcise++; continue; }
        if (dryRun) { totals.wouldCompact++; totals.savedBytes += saved; continue; }
        temporary = join(directory, `.compact-${randomUUID()}.tmp`);
        const out = openSync(temporary, 'wx', before.mode);
        try { writeFileSync(out, text); fsyncSync(out); } finally { closeSync(out); }
        const after = lstatSync(file);
        if (before.ino !== after.ino || before.size !== after.size || before.mtimeMs !== after.mtimeMs || before.ctimeMs !== after.ctimeMs) {
          totals.changedDuringRead++; continue;
        }
        // Same-directory rename replaces the complete file atomically. Never
        // truncate the original; a failed replacement leaves it intact.
        renameSync(temporary, file); temporary = undefined;
        totals.compacted++; totals.savedBytes += saved;
      } catch (error) { warn(file, error); } finally {
        if (temporary) { try { unlinkSync(temporary); } catch (error) { warn(temporary, error); } }
      }
    }
    for (const entry of entries) if (entry.isDirectory() && !entry.isSymbolicLink() && !entry.name.startsWith('.')) {
      try { scan(join(directory, entry.name)); } catch (error) { warn(join(directory, entry.name), error); }
    }
    progress({directory, dryRun, ...totals});
  }
  const directories = paths.map(path => realpathSync(path));
  for (const directory of directories) scan(directory);
  return {directories, dryRun, ...totals, warnings};
}
