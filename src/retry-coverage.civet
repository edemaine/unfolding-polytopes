{basename, dirname, join, resolve} from node:path
{trialName} from ./jobs.civet

export interface RetryCoverage
  resolved: number
  remaining: number | null
  viaRetries: number
  complete: boolean
  directories: string[]
  inProgress: number
  duplicateAssignments: number
  unassigned: number | null
  workers: {directory: string; pid: number; trials: number}[]

export interface CoverageRun
  directory: string
  expected: number | null
  metadata: any
  saved: Set<string>
  resolved: Set<string>
  attempted?: Set<string>
  state?: string
  pid?: number | null

function key(path: string): string
  process.platform is 'win32' ? resolve(path).toLowerCase() : resolve path

function trial(name: unknown): name is string
  name <? 'string' and /^trial-[^\\/]+\.json$/.test name

// Index only trials mentioned by retries. Ordinary successful trials need no
// global graph entries, and neither this pass nor its callers read coordinates.
export function retryCoverage(runs: CoverageRun[], links: [string, string][])
  parents := new Map<string, string>

  function root(path: string): string
    parents.set path, path unless parents.has path
    end .= path
    until parents.get(end)! is end
      end = parents.get(end)!
    until path is end
      next := parents.get(path)!
      parents.set path, end
      path = next

    end

  function connect(a: string, b: string): void
    parents.set root(key a), root key b

  byDirectory := new Map runs.map (run) => [key(run.directory), run]
  plans := new Map<CoverageRun, Set<string>>
  for run of runs
    m := run.metadata
    if Array.isArray m.tasks
      names := new Set<string>
      for task of m.tasks when trial task?.name
        names.add task.name
        if (task.sourceFile <? 'string') connect join(run.directory, task.name), task.sourceFile
      plans.set run, names
    else if Array.isArray m.sourceFiles
      names := new Set<string>
      for [i, file] of m.sourceFiles.entries() when file <? 'string'
        name := (m.sourceDirectories?# ?? 1) > 1 ? `trial-${String(i).padStart 6, '0'}.json` : basename file
        continue unless trial name
        names.add(name); connect join(run.directory, name), file
      plans.set run, names
  for ([a, b] of links) connect a, b
  winners := new Map<string, Set<string>>
  for path of parents.keys()
    run := byDirectory.get key dirname path
    continue unless run?.resolved.has basename path
    id := root path
    winners.set id, new Set unless winners.has id
    winners.get(id)!.add run.directory
  result := new Map<string, RetryCoverage>
  directories := new Map<CoverageRun, Set<string>>
  active := new Map<string, Set<CoverageRun>>
  assignments := new Map<CoverageRun, Map<CoverageRun, number>>
  for run of runs
    continue if run.state is not 'running' or not run.pid
    for name of plans.get(run) ?? []
      continue if (run.attempted ?? run.saved).has name
      id := root key join run.directory, name
      continue if winners.has id
      active.set id, new Set unless active.has id
      active.get(id)!.add run
  for run of runs
    result.set run.directory, resolved: run.resolved.size, remaining: null, viaRetries: 0, complete: false, directories: [], inProgress: 0, duplicateAssignments: 0, unassigned: null, workers: []
    directories.set run, new Set
    assignments.set run, new Map
  for path of parents.keys()
    run := byDirectory.get(key dirname path); name := basename path
    continue if not run or run.resolved.has name
    plan := plans.get(run); m := run.metadata
    if plan
      continue unless plan.has name

    else unless run.saved.has name
      // Missing search trials must belong to the exact reserved seed range.
      match := /^trial-(\d+)-seed-(-?\d+)\.json$/.exec name
      index := match ? Number(match[1]) : NaN
      if (m.generator?.family is not 'random' or not Number.isSafeInteger(m.seed) or not Number.isSafeInteger(index) or index < 0 or
          run.expected is null or index >= run.expected or trialName(index, m.seed + index) is not name) continue
    completedBy := [...winners.get(root path) ?? []].filter (directory) => key(directory) is not key run.directory
    coverage := result.get(run.directory)!
    if completedBy#
      coverage.resolved++; coverage.viaRetries++
      for (directory of completedBy) directories.get(run)!.add directory
    else
      workers := [...active.get(root path) ?? []].filter (worker) => worker is not run
      coverage.inProgress++ if workers#
      coverage.duplicateAssignments++ if workers# > 1
      for worker of workers
        counts := assignments.get(run)!
        counts.set worker, (counts.get(worker) ?? 0) + 1
  for run of runs
    coverage := result.get(run.directory)!
    coverage.remaining = run.expected is null ? null : Math.max 0, run.expected - coverage.resolved
    coverage.complete = run.expected is not null and coverage.resolved is run.expected
    coverage.directories = [...directories.get(run)!].sort()
    coverage.unassigned = coverage.remaining is null ? null : Math.max 0, coverage.remaining - coverage.inProgress
    coverage.workers = [...assignments.get(run)!].map ([worker, trials]) => {worker.directory, pid: worker.pid!, trials}
      .sort (a, b) => a.directory.localeCompare b.directory
  return
    runs: result
    identity: (file: string): string => { path := key(file); parents.has(path) ? root(path) : path }
    isResolved: (file: string): boolean =>
      path := key file
      byDirectory.get(key dirname path)?.resolved.has(basename path) is true or
        parents.has(path) and winners.has root path
