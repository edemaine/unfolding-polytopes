{attachFacet, interiorOverlap, rootPlacement, overlapMethods} from ./unfold.civet
type {Placement, OverlapMethod, OverlapStats} from ./unfold.civet
type {Polytope} from ./polytope.civet

export branchOrders := ['index', 'constrained', 'bottleneck'] as const
export type BranchOrder = typeof branchOrders[number]

export interface SolveOptions
  overlapMethod?: OverlapMethod
  root?: number
  maxNodes?: number
  timeoutMs?: number
  overlapTolerance?: number
  // Disable pruning and/or early success for enumeration and cross-checks.
  pruneOverlaps?: boolean
  stopAfterFirst?: boolean
  forwardCheck?: boolean | 'auto'
  forceBridges?: boolean
  branchOrder?: BranchOrder

export interface SolveResult
  status: 'found' | 'no-unfolding' | 'inconclusive'
  termination: 'solution' | 'exhausted' | 'maxNodes' | 'timeout'
  exhaustive: boolean
  numerical: true
  overlapTolerance: number
  overlapMethod: OverlapMethod
  overlapStats: OverlapStats
  searchOptions: {forwardCheck: boolean | 'auto'; forceBridges: boolean; branchOrder: BranchOrder}
  searchStats: {placements: number; reusedPlacements: number; reusedOverlapChecks: number; parentChecksSkipped: number; blockedEdges: number; forcedEdges: number; graphChecks: number}
  tree: number[] | null
  placements: Placement[] | null
  stats: {nodes: number; completeTrees: number; overlapPrunes: number; disconnectedPrunes: number; solutions: number; elapsedMs: number}

class SearchLimit extends Error
  constructor(public reason: 'maxNodes' | 'timeout')
    super reason


export function solve(poly: Polytope, options: SolveOptions = {}): SolveResult
  start := performance.now()
  maxNodes := options.maxNodes ?? Infinity
  timeoutMs := options.timeoutMs ?? Infinity
  eps := options.overlapTolerance ?? 16 * poly.tolerance
  throw new Error('maxNodes must be a nonnegative safe integer or Infinity.') if not (maxNodes >= 0) or maxNodes is not Infinity and not Number.isSafeInteger maxNodes
  throw new Error('timeoutMs must be nonnegative.') if not (timeoutMs >= 0) or Number.isNaN timeoutMs
  throw new Error('overlapTolerance must be positive and finite.') unless (eps > 0 and Number.isFinite eps)
  overlapMethod := options.overlapMethod ?? 'dual-lp'
  throw new Error('Unknown overlap method.') unless overlapMethod is in overlapMethods
  overlapStats := calls: 0, primalWitnesses: 0, supportSeparations: 0, fallbacks: 0
  forwardCheck := options.pruneOverlaps is not false and (options.forwardCheck ?? 'auto')
  throw new Error('Invalid forward-check mode.') unless forwardCheck is in [true, false, 'auto']
  forceBridges := options.forceBridges ?? true
  branchOrder := options.branchOrder ?? 'constrained'
  throw new Error('Unknown branch order.') unless branchOrder is in branchOrders
  searchOptions := {forwardCheck, forceBridges, branchOrder}
  searchStats := placements: 0, reusedPlacements: 0, reusedOverlapChecks: 0, parentChecksSkipped: 0, blockedEdges: 0, forcedEdges: 0, graphChecks: 0
  root := options.root ?? 0
  stats := nodes: 0, completeTrees: 0, overlapPrunes: 0, disconnectedPrunes: 0, solutions: 0, elapsedMs: 0
  placed := new Map<number, Placement> [[root, rootPlacement poly, root]]
  excluded := new Set<number>
  tree: number[] := []
  placementStack := [...placed.values()]
  interface Candidate
    placement: Placement
    parent: number
    checked: number

  interface Edge
    to: number
    id: number

  witnessTree: number[] | null .= null
  witnessPlacements: Placement[] | null .= null

  function poll(): void
    throw new SearchLimit('timeout') if performance.now() - start >= timeoutMs


  function graph(): {adjacency: Edge[][]; bridges: Set<number>; connected: boolean}
    searchStats.graphChecks++
    contracted := poly.facets#
    adjacency: Edge[][] := Array.from length: contracted + 1, => []
    for id of [0..<poly.ridges#]
      continue if excluded.has id
      [x, y] := poly.ridges[id].facets
      a := placed.has(x) ? contracted : x; b := placed.has(y) ? contracted : y
      continue if a is b
      adjacency[a].push({to: b, id}); adjacency[b].push {to: a, id}
    discovered := new Int32Array(contracted + 1); low := new Int32Array contracted + 1
    bridges := new Set<number>
    clock .= 0

    function visitGraph(v: number, parentEdge: number): void
      discovered[v] = low[v] = ++clock
      for {to, id} of adjacency[v]
        continue if id is parentEdge // Parallel edges are distinct after contraction.
        unless discovered[to]
          visitGraph(to, id); low[v] = Math.min low[v], low[to]
          bridges.add id if low[to] > discovered[v]
        else
          low[v] = Math.min low[v], discovered[to]

    visitGraph contracted, -1
    {adjacency, bridges, connected: clock is contracted - placed.size + 1}

  function candidate(id: number, cache: Map<number, Candidate>): Candidate
    cached := cache.get id
    if cached
      searchStats.reusedPlacements++
      return cached

    edge := poly.ridges[id]
    parent := placed.has(edge.facets[0]) ? edge.facets[0] : edge.facets[1]
    searchStats.placements++
    value := {placement: attachFacet(poly, placed.get(parent)!, id), parent, checked: 0}
    cache.set id, value
    value

  function viable(id: number, cache: Map<number, Candidate>): boolean
    value := candidate id, cache
    searchStats.reusedOverlapChecks += Math.max 0, value.checked - 1
    for i of [value.checked..<placementStack#]
      other := placementStack[i]
      if other.facet is value.parent
        searchStats.parentChecksSkipped++
        continue

      return false if interiorOverlap value.placement, other, eps, poll, overlapMethod, overlapStats
    // Cache entries are immutable: a sibling must not inherit checks against
    // a facet placed only in the branch that just finished.
    cache.set id, {...value, checked: placementStack#}
    true

  function choose(frontier: number[], adjacency: Edge[][]): number
    return frontier[0] if branchOrder is 'index'
    rootVertex := poly.facets#

    function child(id: number): number
      poly.ridges[id].facets.find((f) => not placed.has f)!

    function alternativeDistance(id: number): number
      target := child(id); distance := new Int32Array(adjacency#); distance.fill -1
      distance[rootVertex] = 0
      queue := [rootVertex]
      for i .= 0; i < queue#; i++
        for edge of adjacency[queue[i]] when edge.id is not id and distance[edge.to] < 0
          distance[edge.to] = distance[queue[i]] + 1
          return distance[edge.to] if edge.to is target
          queue.push edge.to
      Infinity
    best .= frontier[0]; bestDegree .= adjacency[child best]#
    bestDistance .= branchOrder is 'bottleneck' ? alternativeDistance(best) : 0
    for id of frontier[>=1]
      degree := adjacency[child id]#
      distance := branchOrder is 'bottleneck' ? alternativeDistance(id) : 0
      if distance > bestDistance or distance is bestDistance and degree < bestDegree
        best = id; bestDegree = degree; bestDistance = distance
    best

  function visit(previous = new Map<number, Candidate>): boolean
    poll()
    throw new SearchLimit('maxNodes') if stats.nodes >= maxNodes
    stats.nodes++
    if placed.size is poly.facets#
      stats.completeTrees++
      faces := [...placed.values()]
      if options.pruneOverlaps is false
        for i of [0..<faces#]
          for j of [0..<i] when interiorOverlap faces[i], faces[j], eps, poll, overlapMethod, overlapStats
            return false
      stats.solutions++
      unless witnessTree
        witnessTree = [...tree]
        witnessPlacements = faces.sort (a, b) => a.facet - b.facet
      return options.stopAfterFirst is not false
    cache := new Map<number, Candidate>
    frontier: number[] := []
    for id of [0..<poly.ridges#]
      [a, b] := poly.ridges[id].facets
      if not excluded.has(id) and placed.has(a) is not placed.has b
        frontier.push id
        cache.set id, previous.get(id)! if previous.has id
    blocked: number[] := []
    // Let easy first descents finish without checking every possible attachment.
    checkForward := forwardCheck is true or forwardCheck is 'auto' and stats.nodes > 2 * poly.facets#
    try
      initial := graph()
      unless initial.connected
        stats.disconnectedPrunes++
        return false

      if checkForward
        for id of frontier when not viable id, cache
          excluded.add(id); blocked.push(id); cache.delete id
          stats.overlapPrunes++; searchStats.blockedEdges++
      remaining := blocked# ? graph() : initial
      unless remaining.connected
        stats.disconnectedPrunes++
        return false

      viableFrontier := frontier.filter (id) => not excluded.has id
      return false unless viableFrontier#
      forced := forceBridges ? viableFrontier.find(remaining.bridges.has(.)) : undefined
      id := forced ?? choose viableFrontier, remaining.adjacency
      searchStats.forcedEdges++ if forced is not undefined
      child := candidate(id, cache).placement
      overlaps := not checkForward and options.pruneOverlaps is not false and not viable id, cache
      if overlaps
        stats.overlapPrunes++
      else
        placed.set(child.facet, child); placementStack.push(child); tree.push id
        let stop: boolean
        try
          stop = visit cache
        finally
          tree.pop()
          placementStack.pop()
          placed.delete child.facet

        return true if stop
      return false if forced is not undefined
      excluded.add id
      try
        visit cache
      finally
        excluded.delete id

    finally
      for (id of blocked) excluded.delete id

  let termination: SolveResult['termination']
  try
    termination = visit() ? 'solution' : 'exhausted'
  catch (error)
    throw error unless (error instanceof SearchLimit)
    termination = error.reason
  stats.elapsedMs = performance.now() - start
  {
    status: witnessTree ? 'found' : termination is 'exhausted' ? 'no-unfolding' : 'inconclusive'
    termination, exhaustive: termination is 'exhausted', numerical: true, overlapTolerance: eps, overlapMethod, overlapStats, searchOptions, searchStats
    tree: witnessTree, placements: witnessPlacements, stats
  }
