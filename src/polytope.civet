"civet esCompat";
import {affineBasis, combinations, dot, mean, mul, norm, perpendicular, residual, sub, unit} from './linalg.civet';
import type {Matrix, Vector} from './linalg.civet';

export interface Facet {
  vertices: number[];
  normal: Vector;
  offset: number;
  basis: Matrix;
  ridges: number[];
}

export interface Ridge {
  facets: [number, number];
  vertices: number[];
  basis: Matrix;
  // Unit vectors pointing from this ridge into each incident facet.
  inward: [Vector, Vector];
}

export interface Polytope {
  dimension: number;
  // Input point indices are retained, including redundant points.
  points: Vector[];
  originalPoints: Vector[];
  center: Vector;
  scale: number;
  tolerance: number;
  facets: Facet[];
  ridges: Ridge[];
  hullCombinations: number;
}

export interface HullOptions {
  tolerance?: number;
  maxCombinations?: number;
}

export function convexHull(input: Vector[], options: HullOptions = {}): Polytope {
  const eps = options.tolerance ?? 1e-9;
  const budget = options.maxCombinations ?? Infinity;
  if (!(eps > 0 && eps < 0.01)) throw new Error('Tolerance must be between 0 and 0.01.');
  if (!(budget >= 0) || (budget !== Infinity && !Number.isSafeInteger(budget))) throw new Error('Invalid hull combination budget.');
  if (!Array.isArray(input) || !input.length || !Array.isArray(input[0])) throw new Error('Expected an array of coordinate arrays.');
  const d = input[0].length;
  if (d < 2 || input.length < d + 1) throw new Error('Need at least d+1 points in dimension d >= 2.');
  if (input.some(p => !Array.isArray(p) || p.length !== d || !p.every(x => typeof x === 'number' && Number.isFinite(x)))) {
    throw new Error('Coordinates must be finite numbers in a common dimension.');
  }
  const center = input[0].map((_, j) => {
    const values = input.map(p => p[j]);
    return Math.min(...values) / 2 + Math.max(...values) / 2;
  });
  const scale = Math.max(...input.map(p => norm(sub(p, center))));
  if (!(scale > 0 && Number.isFinite(scale))) throw new Error('Degenerate or out-of-range coordinates.');
  const points = input.map(p => mul(sub(p, center), 1 / scale));
  if (affineBasis(points, eps).length !== d) throw new Error('Input is not full dimensional at the chosen tolerance.');

  // Enumerate supporting hyperplanes through d affinely independent points.
  // Deduplicate by ALL coplanar points: a cube has six facets, not twelve triangles.
  const facets: Facet[] = [];
  const seen = new Set<string>();
  let hullCombinations = 0;
  for (const ids of combinations(points.length, d)) {
    if (hullCombinations >= budget) throw new Error('Hull combination budget exceeded; no search performed.');
    hullCombinations++;
    const basis = affineBasis(ids.map(i => points[i]), eps);
    if (basis.length !== d - 1) continue;
    let normal = perpendicular(basis, d, eps);
    let offset = dot(normal, points[ids[0]]);
    let distances = points.map(p => dot(normal, p) - offset);
    const positive = distances.some(x => x > eps);
    const negative = distances.some(x => x < -eps);
    if (positive && negative) continue;
    if (!positive && !negative) throw new Error('Ambiguous supporting plane at the chosen tolerance.');
    if (positive) {
      normal = mul(normal, -1); offset = -offset;
      distances = distances.map(x => -x);
    }
    const vertices = distances.flatMap((x, i) => Math.abs(x) <= eps ? [i] : []);
    const key = vertices.join(',');
    if (seen.has(key)) continue;
    seen.add(key);
    if (affineBasis(vertices.map(i => points[i]), eps).length !== d - 1) {
      throw new Error('Inconsistent coplanarity; try a different tolerance.');
    }
    facets.push({vertices, normal, offset, basis, ridges: []});
  }
  facets.sort((a, b) => a.vertices.join(',') < b.vertices.join(',') ? -1 : 1);
  if (facets.length < d + 1) throw new Error('Could not construct a closed full-dimensional hull.');

  const ridges: Ridge[] = [];
  const ridgeKeys = new Set<string>();
  for (let a = 0; a < facets.length; a++) {
    for (let b = a + 1; b < facets.length; b++) {
      const vertices = facets[a].vertices.filter(i => facets[b].vertices.includes(i));
      if (vertices.length < d - 1) continue;
      const basis = affineBasis(vertices.map(i => points[i]), eps);
      if (basis.length < d - 2) continue;
      if (basis.length !== d - 2 || ridgeKeys.has(vertices.join(','))) {
        throw new Error('Inconsistent ridge incidence; try a different tolerance.');
      }
      ridgeKeys.add(vertices.join(','));
      const inward = [a, b].map(f => unit(residual(sub(mean(facets[f].vertices.map(i => points[i])), points[vertices[0]]), basis), eps)) as [Vector, Vector];
      const id = ridges.length;
      ridges.push({facets: [a, b], vertices, basis, inward});
      facets[a].ridges.push(id); facets[b].ridges.push(id);
    }
  }
  for (const facet of facets) {
    if (facet.ridges.length < d) throw new Error('Facet has too few ridges; hull is numerically inconsistent.');
  }
  const reached = new Set([0]);
  const queue = [0];
  for (let i = 0; i < queue.length; i++) {
    for (const r of facets[queue[i]].ridges) {
      for (const f of ridges[r].facets) if (!reached.has(f)) { reached.add(f); queue.push(f); }
    }
  }
  if (reached.size !== facets.length) throw new Error('Facet graph is disconnected; hull is numerically inconsistent.');
  return {dimension: d, points, originalPoints: input.map(p => [...p]), center, scale, tolerance: eps, facets, ridges, hullCombinations};
}
