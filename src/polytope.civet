{affineBasis, combinations, dot, mean, mul, norm, perpendicular, residual, sub, unit} from ./linalg.civet
{incrementalHull, HullPrecisionError} from ./hull-incremental.civet
type {Matrix, Vector} from ./linalg.civet

export interface Facet
  vertices: number[]
  normal: Vector
  offset: number
  basis: Matrix
  ridges: number[]

export interface Ridge
  facets: [number, number]
  vertices: number[]
  basis: Matrix
  // Unit vectors pointing from this ridge into each incident facet.
  inward: [Vector, Vector]

export interface Polytope
  dimension: number
  // Input point indices are retained, including redundant points.
  points: Vector[]
  originalPoints: Vector[]
  center: Vector
  scale: number
  tolerance: number
  facets: Facet[]
  ridges: Ridge[]
  hullCombinations: number
  hullMethod: HullMethod
  hullFallback?: string

export hullMethods := ['enumerate', 'incremental'] as const
export type HullMethod = typeof hullMethods[number]

export interface HullOptions
  method?: HullMethod
  tolerance?: number
  maxCombinations?: number

export function convexHull(input: Vector[], options: HullOptions = {}): Polytope
  method := options.method ?? 'incremental'
  throw new Error('Invalid hull method.') unless method is in hullMethods
  eps := options.tolerance ?? 1e-9
  budget := options.maxCombinations ?? Infinity
  throw new Error('Tolerance must be between 0 and 0.01.') unless (eps > 0 and eps < 0.01)
  throw new Error('Invalid hull combination budget.') if not (budget >= 0) or budget is not Infinity and not Number.isSafeInteger budget
  throw new Error('Expected an array of coordinate arrays.') if not Array.isArray(input) or not input# or not Array.isArray input[0]
  d := input[0]#
  throw new Error('Need at least d+1 points in dimension d >= 2.') if d < 2 or input# < d + 1
  if input.some (p) => not Array.isArray(p) or p# is not d or not p.every (x) => x <? 'number' and Number.isFinite x
    throw new Error 'Coordinates must be finite numbers in a common dimension.'
  center := input[0].map (_, j) =>
    values := input.map (p) => p[j]
    Math.min(...values) / 2 + Math.max(...values) / 2

  scale := Math.max ...input.map (p) => norm sub p, center
  throw new Error('Degenerate or out-of-range coordinates.') unless (scale > 0 and Number.isFinite scale)
  points := input.map (p) => mul sub(p, center), 1 / scale
  throw new Error('Input is not full dimensional at the chosen tolerance.') if affineBasis(points, eps)# is not d

  // Construct candidate supporting hyperplanes through d independent points.
  // Deduplicate by ALL coplanar points: a cube has six facets, not twelve triangles.
  facets: Facet[] := []
  seen := new Set<string>
  hullCombinations .= 0

  function consume(): void
    throw new Error('Hull combination budget exceeded; no search performed.') if hullCombinations >= budget
    hullCombinations++
  try
    boundary := method is 'incremental' ? incrementalHull(points, eps, consume) : undefined
    simplexFacetKeys: string[] := []
    candidates := boundary ? boundary.faces : combinations points#, d
    for candidate of candidates
      consume()
      cached := Array.isArray(candidate) ? undefined : candidate
      ids := Array.isArray(candidate) ? candidate : candidate.vertices
      basis .= cached?.basis ?? affineBasis ids.map((i) => points[i]), eps
      if basis# is not d - 1
        throw new HullPrecisionError('Degenerate final incremental simplex.') if boundary
        continue
      normal .= cached?.normal ?? perpendicular basis, d, eps
      offset .= cached?.offset ?? dot normal, points[ids[0]]
      distances .= points.map (p) => dot(normal, p) - offset
      positive := distances.some (x) => x > eps
      negative := distances.some (x) => x < -eps
      if positive and negative
        throw new HullPrecisionError('Incremental facet is not supporting.') if method is 'incremental'
        continue
      throw new HullPrecisionError('Ambiguous supporting plane at the chosen tolerance.') if not positive and not negative
      if positive
        normal = mul(normal, -1); offset = -offset
        distances = distances.map (x) => -x
      vertices := distances.flatMap (x, i) => Math.abs(x) <= eps ? [i] : []
      key := vertices.join ','
      simplexFacetKeys.push key if boundary
      continue if seen.has key
      seen.add key
      canonical := vertices# is ids# and vertices.every (v, i) => v is ids[i]
      fullBasis := canonical ? basis : affineBasis vertices.map((i) => points[i]), eps
      if fullBasis# is not d - 1
        throw new HullPrecisionError 'Inconsistent coplanarity; try a different tolerance.'
      if boundary and not canonical
        // Match the enumerator's lexicographic basis and orientation, so facet
        // IDs, ridge IDs, and subsequent tree-search order remain comparable.
        basis = fullBasis
        normal = perpendicular basis, d, eps
        offset = dot normal, points[vertices[0]]
        if points.some (p) => dot(normal, p) - offset > eps
          normal = mul normal, -1
          offset = -offset

        coplanar := points.flatMap (p, i) => Math.abs(dot(normal, p) - offset) <= eps ? [i] : []
        throw new HullPrecisionError('Unstable incremental coplanarity.') if points.some((p) => dot(normal, p) - offset > eps) or coplanar.join(',') is not key
      facets.push {vertices, normal, offset, basis, ridges: []}
    facets.sort (a, b) => a.vertices.join(',') < b.vertices.join(',') ? -1 : 1
    throw new HullPrecisionError('Could not construct a closed full-dimensional hull.') if facets# < d + 1

    ridges: Ridge[] := []
    ridgeKeys := new Set<string>
    function* adjacentFacets(): Generator<[number, number]>
      unless boundary
        for a of [0..<facets#]
          for (b of [a + 1..<facets#]) yield [a, b]
        return
      facetIds := new Map facets.map (f, i) => [f.vertices.join(','), i]
      pairs := new Map<string, [number, number]>
      for [i, j] of boundary.adjacency
        a := facetIds.get(simplexFacetKeys[i]); b := facetIds.get simplexFacetKeys[j]
        throw new HullPrecisionError('Missing incremental facet mapping.') if a is undefined or b is undefined
        continue if a is b // Triangulation boundary internal to one true facet.
        pair: [number, number] := a < b ? [a, b] : [b, a]
        pairs.set pair.join(','), pair
      // Preserve the enumerator's ridge IDs and therefore tree-search order.
      yield* [...pairs.values()].sort (a, b) => a[0] - b[0] or a[1] - b[1]
    centers := facets.map (f) => mean f.vertices.map (i) => points[i]
    for [a, b] of adjacentFacets()
      vertices := facets[a].vertices.filter (i) => i is in facets[b].vertices
      if vertices# < d - 1
        throw new HullPrecisionError('Incremental neighbors do not share a ridge.') if boundary
        continue
      basis := affineBasis vertices.map((i) => points[i]), eps
      if basis# < d - 2
        throw new HullPrecisionError('Degenerate incremental ridge.') if boundary
        continue
      if basis# is not d - 2 or ridgeKeys.has vertices.join ','
        throw new HullPrecisionError 'Inconsistent ridge incidence; try a different tolerance.'
      ridgeKeys.add vertices.join ','
      inward := [a, b].map((f) => unit residual(sub(centers[f], points[vertices[0]]), basis), eps) as [Vector, Vector]
      id := ridges#
      ridges.push {facets: [a, b], vertices, basis, inward}
      facets[a].ridges.push(id); facets[b].ridges.push id
    for facet of facets
      throw new HullPrecisionError('Facet has too few ridges; hull is numerically inconsistent.') if facet.ridges# < d
    reached := new Set [0]
    queue := [0]
    for i .= 0; i < queue#; i++
      for r of facets[queue[i]].ridges
        for f of ridges[r].facets when not reached.has f
          reached.add f
          queue.push f

    throw new HullPrecisionError 'Facet graph is disconnected; hull is numerically inconsistent.' if reached.size is not facets#
    {dimension: d, points, originalPoints: input.map((p) => [...p]), center, scale, tolerance: eps, facets, ridges, hullCombinations, hullMethod: method}
  catch (error)
    throw error if method is not 'incremental' or not (error instanceof HullPrecisionError)
    result := convexHull input, {...options, method: 'enumerate', maxCombinations: budget - hullCombinations}
    {...result, hullCombinations: result.hullCombinations + hullCombinations, hullFallback: error.message}
