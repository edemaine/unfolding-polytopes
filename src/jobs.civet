{existsSync, mkdirSync, readFileSync, readdirSync, rmdirSync} from node:fs
{basename, join} from node:path
{randomPoints, randomScales} from ./generators.civet
type {Distribution} from ./generators.civet
type {HullOptions} from ./polytope.civet
type {SolveOptions} from ./solver.civet
type {Vector} from ./linalg.civet

export interface GeneratorSpec
  family: string
  dimension: number
  count: number
  seed: number
  distribution?: Distribution
  scales?: number[]
  randomScales?: number
  weight?: number

export interface TrialTask
  name: string
  sourceFile?: string
  seed?: number
  generator?: GeneratorSpec
  input?: {points: Vector[]; generator?: GeneratorSpec}
  hullOptions: HullOptions
  solveOptions: SolveOptions

export function trialName(index: number, seed: number): string
  `trial-${String(index).padStart 6, '0'}-seed-${seed}.json`

export function trialStatuses(directory: string): {statuses: Map<string, string>; invalidRows: number}
  statuses := new Map<string, string>
  invalidRows .= 0
  path := join directory, 'trials.jsonl'
  return {statuses, invalidRows} unless existsSync path
  for line of readFileSync(path, 'utf8').split '\n'
    continue unless line.trim()
    try
      row := JSON.parse line
      if row?.file !<? 'string' or not /^trial-[^\\/]+\.json$/.test row.file
        invalidRows++
        continue

      unless row.status is in ['found', 'no-unfolding', 'inconclusive', 'error']
        statuses.delete(row.file); invalidRows++; continue
      statuses.set row.file, row.status
    catch
      invalidRows++

  {statuses, invalidRows}

export function generatedInput(generator: GeneratorSpec): {points: Vector[]; generator: GeneratorSpec}
  throw new Error('Missing trial requires a saved random generator.') if generator.family is not 'random'
  scales := generator.randomScales is undefined ? generator.scales ?? Array(generator.dimension).fill(1) : randomScales(generator.dimension, generator.seed, generator.randomScales)
  throw new Error('Invalid saved generator scales.') if scales# is not generator.dimension or scales.some (x) => not (x > 0 and Number.isFinite x)
  {points: randomPoints(generator.dimension, generator.count, generator.seed, generator.distribution ?? 'sphere').map((p) => p.map (x, j) => x * scales[j]), generator: generator.randomScales is undefined ? generator : {...generator, scales}}

// Describe unexecuted tasks without allocating their point sets. New retries
// persist these descriptors, so an interrupted retry is itself resumable.
export function missingTasks(directory: string, files: Set<string>, include: (name: string) => boolean = => true): TrialTask[]
  return [] unless existsSync join directory, 'run.json'
  run := JSON.parse readFileSync join(directory, 'run.json'), 'utf8'
  if Array.isArray run.tasks
    names := new Set<string>
    for task of run.tasks
      throw new Error(`Invalid task names in ${join directory, 'run.json'}`) if task.name !<? 'string' or not /^trial-[^\\/]+\.json$/.test(task.name) or names.has task.name
      names.add task.name
    return run.tasks.filter (t: TrialTask) => not files.has(t.name) and include t.name
  if Array.isArray run.sourceFiles
    // Compatibility with retry runs written before task manifests existed.
    multiple := (run.sourceDirectories?# ?? 1) > 1
    return run.sourceFiles.flatMap (sourceFile: string, i: number) =>
      name := multiple ? `trial-${String(i).padStart 6, '0'}.json` : basename sourceFile
      return [] if files.has(name) or not include name
      saved := JSON.parse readFileSync sourceFile, 'utf8'
      old := run.overrides ?? {}
      hullOptions := {...saved.hullOptions}
      solveOptions := {...saved.solveOptions}
      hullOptions.tolerance = Number old.tolerance if old.tolerance is not undefined
      solveOptions.overlapTolerance = Number old['overlap-tolerance'] if old['overlap-tolerance'] is not undefined
      solveOptions.root = Number old.root if old.root is not undefined
      solveOptions.stopAfterFirst = false if old.all
      solveOptions.pruneOverlaps = false if old['no-prune']
      [{name, sourceFile, saved.generator, saved.generator?.seed, hullOptions, solveOptions}]

  return [] if run.generator?.family is not 'random'
  throw new Error(`Invalid seed range in ${join directory, 'run.json'}`) if not Number.isSafeInteger(run.seed) or not Number.isSafeInteger(run.trials) or run.trials < 0 or not Number.isSafeInteger run.seed + run.trials - 1
  tasks: TrialTask[] := []
  for i of [0..<run.trials]
    seed := run.seed + i
    name := trialName i, seed
    if not files.has(name) and include name
      tasks.push {
        name
        sourceFile: join directory, name
        seed
        generator: {...run.generator, seed}
        run.hullOptions ?? {}
        run.solveOptions ?? {}
      }
  tasks

export function taskInput(task: TrialTask): {points: Vector[]; generator?: GeneratorSpec}
  return task.input if task.input
  if task.sourceFile and existsSync task.sourceFile
    saved := JSON.parse readFileSync task.sourceFile, 'utf8'
    return saved.{points, generator}
  return generatedInput task.generator if task.generator
  throw new Error `Cannot reconstruct missing trial ${task.sourceFile ?? task.name}`

function generatorKey(g: GeneratorSpec): string
  JSON.stringify [g.family, g.dimension, g.count, g.distribution ?? 'sphere', g.randomScales is undefined ? g.scales ?? Array(g.dimension).fill(1) : {randomScales: g.randomScales}]

// The entire planned range is reserved, even for unfinished runs. Matching
// ignores tolerances and solver limits, which do not affect generated points.
export function nextSearchSeed(parent: string, generator: GeneratorSpec, trials: number): number
  key := generatorKey generator
  next .= 0

  function reserve(g: GeneratorSpec?, start: number, count: number): void
    return if not g or g.family is not 'random' or generatorKey(g) is not key
    throw new Error('Invalid seed range in saved history; specify --seed explicitly.') if not Number.isSafeInteger(start) or not Number.isSafeInteger(count) or count < 0 or not Number.isSafeInteger start + count
    // Mulberry32 reduces seeds modulo 2^32. Refuse ambiguous legacy ranges.
    throw new Error('Saved matching seeds wrap the 32-bit PRNG range; specify --seed explicitly.') if start < 0 or start + count > 2 ** 32
    next = Math.max next, start + count

  function scan(directory: string): void
    entries := readdirSync directory, withFileTypes: true
    if entries.some (e) => e.isFile() and e.name is 'run.json'
      run := JSON.parse readFileSync join(directory, 'run.json'), 'utf8'
      if run.generator
        reserve run.generator, run.seed, run.trials
      else if Array.isArray run.tasks
        for (task of run.tasks) reserve task.generator, task.generator?.seed, 1
      else if Array.isArray run.sourceFiles
        for file of run.sourceFiles
          saved := JSON.parse readFileSync file, 'utf8'
          reserve saved.generator, saved.generator?.seed, 1
    for e of entries when e.isDirectory() and not e.isSymbolicLink() and e.name is not '.seed-allocation-lock'
      scan join directory, e.name
  scan parent
  throw new Error('Automatic seeds exhausted the 32-bit PRNG range; specify --seed explicitly to allow reuse.') if next + trials > 2 ** 32
  next

// Serialize reading history and writing the new run metadata across processes.
// A bounded wait avoids hanging on a lock left by a killed process.
export function withSeedLock<T>(parent: string, action: => T): T
  mkdirSync parent, recursive: true
  lock := join parent, '.seed-allocation-lock'
  start := performance.now()
  loop
    try
      mkdirSync lock
      break
    catch (error)
      throw error if (error as NodeJS.ErrnoException).code is not 'EEXIST'
      throw new Error(`Seed allocation is locked at ${lock}. Another search may be starting; if it was killed, remove this empty lock directory and retry.`) if performance.now() - start > 10_000
      Atomics.wait new Int32Array(new SharedArrayBuffer 4), 0, 0, 50
  try
    action()
  finally
    rmdirSync lock
