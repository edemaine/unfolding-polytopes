{dirname, join, relative} from node:path
{readFileSync} from node:fs
{summarizeResults} from ./summary.civet

export interface TimingDistribution
  count: number
  totalMs: number
  minMs: number
  medianMs: number
  p90Ms: number
  p99Ms: number
  p999Ms: number
  maxMs: number
  overSecond: number
  overMinute: number
  overHour: number
  overDay: number

export interface NodeDistribution
  count: number
  totalNodes: number
  minNodes: number
  medianNodes: number
  p90Nodes: number
  p99Nodes: number
  p999Nodes: number
  maxNodes: number
  overThousand: number
  overMillion: number
  overBillion: number

interface GroupParameters
  directory?: string
  dimension: number | null
  points: number | null
  outcome: string
  parameters: {family?: string; distribution?: string; scales?: number[]; weight?: number}

export type TimingGroup = GroupParameters & (TimingDistribution | NodeDistribution)
export interface TimingReport
  metric: 'time' | 'nodes'
  directory: string
  byRun: boolean
  includeTimeouts: boolean
  omittedTimeouts: number
  groups: TimingGroup[]
  totals: ((TimingDistribution | NodeDistribution) & {outcome: string})[]
  savedAttempts: number
  missingTimes?: number
  missingNodes?: number
  unreadable: number
  warnings: string[]

function distribution(values: number[], nodes: boolean): TimingDistribution | NodeDistribution
  values.sort (a, b) => a - b

  function percentile(p: number): number
    values[Math.ceil(p * values#) - 1]
  if nodes
    result: NodeDistribution := count: values#, totalNodes: 0, minNodes: values[0], medianNodes: percentile(.5), p90Nodes: percentile(.9), p99Nodes: percentile(.99), p999Nodes: percentile(.999), maxNodes: values.at(-1)!, overThousand: 0, overMillion: 0, overBillion: 0
    for value of values
      result.totalNodes += value
      result.overThousand++ if value > 1000
      result.overMillion++ if value > 1000000
      result.overBillion++ if value > 1000000000
    return result
  result: TimingDistribution := count: values#, totalMs: 0, minMs: values[0], medianMs: percentile(.5), p90Ms: percentile(.9), p99Ms: percentile(.99), p999Ms: percentile(.999), maxMs: values.at(-1)!, overSecond: 0, overMinute: 0, overHour: 0, overDay: 0
  for value of values
    result.totalMs += value
    result.overSecond++ if value > 1000
    result.overMinute++ if value > 60000
    result.overHour++ if value > 3600000
    result.overDay++ if value > 86400000
  result

export function summarizeTimings(path = 'results', byRun = false, includeTimeouts = false, nodes = false): TimingReport
  groups := new Map<string, GroupParameters & {values: number[]}>
  totals := new Map<string, number[]>
  generators := new Map<string, {common: any; tasks: Map<string, any>}>
  sources := new Map<string, any>

  function sourceGenerator(metadata: any, seen = new Set<string>): any
    return metadata.generator if metadata?.generator
    source := metadata?.sourceDirectory
    return undefined if source !<? 'string' or seen.has source
    return sources.get source if sources.has source
    seen.add source
    let generator: any
    try
      generator = sourceGenerator JSON.parse(readFileSync join(source, 'run.json'), 'utf8'), seen
    catch {}
    sources.set source, generator
    generator
  missingTimes .= 0
  omittedTimeouts .= 0
  // Reuse summary's journal deduplication, saved-file checks, and fallback reader.
  summary := summarizeResults path, (run, row, metadata) =>
    value := nodes ? row.nodes : row.elapsedMs
    if value !<? 'number' or not Number.isFinite(value) or value < 0 or nodes and not Number.isSafeInteger value
      missingTimes++
      return

    if not includeTimeouts and row.termination is 'timeout'
      omittedTimeouts++
      return

    outcome .= row.status
    switch row.termination
      when 'timeout'
        outcome = row.status is 'found' ? 'found/timeout' : 'timeout'
      when 'maxNodes'
        outcome = row.status is 'found' ? 'found/node-limit' : 'node-limit'

    saved .= generators.get run.directory
    unless saved
      saved = common: sourceGenerator(metadata), tasks: new Map
      for task of Array.isArray(metadata.tasks) ? metadata.tasks : [] when task?.generator and task.name <? 'string'
        saved.tasks.set task.name, task.generator
      generators.set run.directory, saved
    generator := row.generator ?? saved.tasks.get(row.file) ?? saved.common ?? (row.sourceFile <? 'string' ? sourceGenerator(sourceDirectory: dirname row.sourceFile) : undefined)
    dimension := Number.isSafeInteger(generator?.dimension) and generator.dimension >= 2 ? generator.dimension : run.dimension
    points := Number.isSafeInteger(generator?.count) and generator.count >= 0 ? generator.count : run.points
    family := generator?.family <? 'string' ? generator.family : generator ? 'random' : undefined
    parameters: TimingGroup['parameters'] := {family}
    parameters.distribution = generator.distribution <? 'string' ? generator.distribution : 'sphere' if family is 'random'
    parameters.weight = generator.weight if family is 'hypersimplex' and Number.isFinite generator.weight
    if dimension is not null and generator
      if generator.scales is undefined
        parameters.scales = Array(dimension).fill 1

      else if Array.isArray(generator.scales) and generator.scales# is dimension and generator.scales.every (s: unknown) => s <? 'number' and Number.isFinite s
        parameters.scales = generator.scales

    directory := byRun ? run.directory : undefined
    key := JSON.stringify [directory, dimension, points, parameters, outcome]
    group .= groups.get key
    unless group
      group = {directory, dimension, points, parameters, outcome, values: []}
      groups.set key, group
    group.values.push value
    totals.set outcome, [] unless totals.has outcome
    totals.get(outcome)!.push value;

  function compare(a: number | null, b: number | null): number
    a is b ? 0 : a is null ? 1 : b is null ? -1 : a - b
  ordered := [...groups.values()].sort (a, b) => compare(a.dimension, b.dimension) or compare(a.points, b.points) or JSON.stringify(a.parameters).localeCompare(JSON.stringify b.parameters) or (a.directory ?? '').localeCompare(b.directory ?? '') or a.outcome.localeCompare b.outcome
  {summary.directory, metric: nodes ? 'nodes' : 'time', byRun, includeTimeouts, omittedTimeouts
    groups: ordered.map ({values, ...group}) => {...group, ...distribution values, nodes}
    totals: [...totals].sort(([a], [b]) => a.localeCompare b).map ([outcome, values]) => {outcome, ...distribution values, nodes}
    savedAttempts: summary.totals.trials, ...nodes ? missingNodes: missingTimes : {missingTimes}, summary.totals.unreadable, summary.warnings}

function duration(ms: number): string
  return `${ms.toFixed 2}ms` if ms < 1000
  return `${(ms / 1000).toFixed 2}s` if ms < 60000
  return `${(ms / 60000).toFixed 2}m` if ms < 3600000
  return `${(ms / 3600000).toFixed 2}h` if ms < 86400000
  `${(ms / 86400000).toFixed 2}d`

export function formatTimings(report: TimingReport): string
  nodes := report.metric is 'nodes'
  header := [...report.byRun ? ['Run'] : [], 'd', 'Points', 'Parameters', 'Outcome', 'N', 'Min', 'Median', 'P90', 'P99', 'P99.9', 'Max', ...nodes ? ['>1K', '>1M', '>1B'] : ['>1s', '>1m', '>1h', '>1d']]
  rows: string[][] := [header]

  function cells(g: TimingDistribution | NodeDistribution): string[]
    'minNodes' in g
      ? [String(g.count), ...[g.minNodes, g.medianNodes, g.p90Nodes, g.p99Nodes, g.p999Nodes, g.maxNodes].map((n) => n.toLocaleString 'en-US'), ...[g.overThousand, g.overMillion, g.overBillion].map String]
      : [String(g.count), ...[g.minMs, g.medianMs, g.p90Ms, g.p99Ms, g.p999Ms, g.maxMs].map(duration), ...[g.overSecond, g.overMinute, g.overHour, g.overDay].map String]
  for group of report.groups
    p := group.parameters
    parameters := (p.family is 'random' ? p.distribution : p.family) ?? '?'
    detail := (p.weight is undefined ? '' : ` weight=${p.weight}`) + (p.scales?.some((s) => s is not 1) ? ` scales=${p.scales.join ','}` : '')
    rows.push [...report.byRun ? [relative(report.directory, group.directory!) or '.'] : [], String(group.dimension ?? '?'), String(group.points ?? '?'), parameters + detail, group.outcome, ...cells group]
  if report.groups#
    rows.push Array(header#).fill ''
    rows.push header

  for (total of report.totals) rows.push [...report.byRun ? ['TOTAL'] : [], report.byRun ? '-' : 'TOTAL', '-', '-', total.outcome, ...cells total]
  widths := header.map (_, i) => Math.max ...rows.map (row) => row[i]#
  lines := [`Search ${nodes ? 'nodes' : 'timings'}: ${report.directory}`, '', ...rows.map((row) => row.map((cell, i) => cell.padEnd widths[i]).join('  ').trimEnd()), ''
    nodes ? 'Nodes count visited tree-search states. Tail counts are cumulative and strictly greater than 1,000 / 1,000,000 / 1,000,000,000.' : 'Times exclude hull construction. Tail counts are cumulative and strictly greater than each threshold.'
    nodes ? 'Cutoffs are reported separately; their node counts measure partial searches.' : 'Cutoffs are reported separately; their recorded durations are lower bounds on time to finish.'
    'Percentiles use nearest rank; P99.9 is the 99.9th percentile and may equal the maximum in small groups.'
    `${report.savedAttempts} saved attempts; ${nodes ? report.missingNodes : report.missingTimes} without valid ${nodes ? 'node count' : 'timing'}; ${report.unreadable} unreadable. Retries count separately.`]
  lines.push nodes ? 'No recorded search node counts.' : 'No recorded search timings.' unless report.groups#
  lines.push `${report.omittedTimeouts} timed-out attempts omitted; use --include-timeouts to show them.` if report.omittedTimeouts
  if (report.warnings#) lines.push '', ...report.warnings.map (w) => `Warning: ${w}`
  lines.join('\n') + '\n'
