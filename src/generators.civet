{combinations, norm, mul, orthonormal, apply} from ./linalg.civet
type {Vector} from ./linalg.civet

function dimension(d: number): void
  throw new Error('Dimension must be an integer >= 2.') if not Number.isSafeInteger(d) or d < 2

// Mulberry32: explicit seeds give reproducible point sets across runs.
export function randomSource(seed: number): => number
  throw new Error('Seed must be a safe integer.') unless Number.isSafeInteger seed
  state .= seed >>> 0
  =>
    state = state + 0x6D2B79F5 >>> 0
    t .= Math.imul state ^ state >>> 15, 1 | state
    t ^= t + Math.imul t ^ t >>> 7, 61 | t
    ((t ^ t >>> 14) >>> 0) / 4294967296

export type Distribution = 'sphere' | 'ball' | 'gaussian' | 'box'

// A separate deterministic stream keeps scale choices separate from point sampling.
export function randomScales(d: number, seed: number, maxRatio = 100): number[]
  dimension d
  throw new Error('Seed must be a safe integer.') unless Number.isSafeInteger seed
  throw new Error('Maximum aspect ratio must be finite and >= 1.') unless Number.isFinite(maxRatio) and maxRatio >= 1
  random := randomSource seed ^ 0x6a09e667
  Array.from length: d, => maxRatio ** -random()

export function randomPoints(d: number, count: number, seed = 0, distribution: Distribution = 'sphere'): Vector[]
  dimension d
  throw new Error('Point count must be an integer >= d+1.') if not Number.isSafeInteger(count) or count < d + 1
  throw new Error('Unknown random distribution.') unless distribution is in ['sphere', 'ball', 'gaussian', 'box']
  random := randomSource seed

  function gaussian(): number
    Math.sqrt(-2 * Math.log 1 - random()) * Math.cos 2 * Math.PI * random()
  Array.from length: count, =>
    if (distribution is 'box') return Array.from length: d, => 2 * random() - 1
    let v: Vector
    do
      v = Array.from {length: d}, gaussian
    while norm(v) is 0
    return v if distribution is 'gaussian'
    radius := distribution is 'ball' ? random() ** (1 / d) : 1
    mul v, radius / norm v


export function simplex(d: number): Vector[]
  dimension d
  // Project e_0,...,e_d from their affine span to R^d, preserving distances.
  basis := orthonormal Array.from(length: d, (_, i) =>
    Array.from length: d + 1, (_, j) => Number(i is j) - Number j is d), 1e-12
  Array.from length: d + 1, (_, i) => apply basis,
    Array.from length: d + 1, (_, j) => Number(i is j) - 1 / (d + 1)

export function hypercube(d: number): Vector[]
  dimension d
  points: Vector[] .= [[]]
  for (i of [0..<d]) points = points.flatMap (p) => [[...p, -1], [...p, 1]]
  points

export function crossPolytope(d: number): Vector[]
  dimension d
  Array.from(length: d, (_, i) => [-1, 1].map (sign) =>
    Array.from length: d, (_, j) => i is j ? sign : 0).flat()

export function cyclic(d: number, count: number): Vector[]
  dimension d
  throw new Error('Point count must be an integer >= d+1.') if not Number.isSafeInteger(count) or count < d + 1
  Array.from length: count, (_, i) =>
    t := 2 * i / (count - 1) - 1
    Array.from length: d, (_, j) => t ** (j + 1)


export function product(a: Vector[], b: Vector[]): Vector[]
  a.flatMap (p) => b.map (q) => [...p, ...q]

export function prism(points: Vector[], height = 2): Vector[]
  throw new Error('Height must be positive and finite.') unless (height > 0 and Number.isFinite height)
  product points, [[-height / 2], [height / 2]]

export function pyramid(points: Vector[], height = 1): Vector[]
  throw new Error('Expected points and positive finite height.') if not points# or not (height > 0 and Number.isFinite height)
  center := points[0].map (_, j) => points.reduce (s, p) => s + p[j] / points#, 0
  [...points.map((p) => [...p, 0]), [...center, height]]

export function hypersimplex(d: number, weight: number): Vector[]
  dimension d
  throw new Error('Weight must be between 1 and d.') if not Number.isInteger(weight) or weight < 1 or weight > d
  // {0,1}^{d+1} points of fixed weight, projected isometrically to dimension d.
  basis := orthonormal Array.from(length: d, (_, i) =>
    Array.from length: d + 1, (_, j) => Number(i is j) - Number j is d), 1e-12
  [...combinations d + 1, weight].map (ids) => apply basis,
    Array.from length: d + 1, (_, j) => Number(j is in ids) - weight / (d + 1)
