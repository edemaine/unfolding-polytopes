import {combinations, norm, mul, orthonormal, apply} from './linalg.civet'
import type {Vector} from './linalg.civet'

function dimension(d: number): void {
  if (not Number.isSafeInteger(d) or d < 2) throw new Error('Dimension must be an integer >= 2.')
}

// Mulberry32: explicit seeds give reproducible point sets across runs.
export function randomSource(seed: number): () => number {
  if (not Number.isSafeInteger(seed)) throw new Error('Seed must be a safe integer.')
  let state = seed >>> 0
  return => {
    state = (state + 0x6D2B79F5) >>> 0
    let t = Math.imul(state ^ (state >>> 15), 1 | state)
    t ^= t + Math.imul(t ^ (t >>> 7), 61 | t)
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}

export type Distribution = 'sphere' | 'ball' | 'gaussian' | 'box'

export function randomPoints(d: number, count: number, seed = 0, distribution: Distribution = 'sphere'): Vector[] {
  dimension(d)
  if (not Number.isSafeInteger(count) or count < d + 1) throw new Error('Point count must be an integer >= d+1.')
  if (not ['sphere', 'ball', 'gaussian', 'box'].includes(distribution)) throw new Error('Unknown random distribution.')
  const random = randomSource(seed)
  const gaussian = : number => Math.sqrt(-2 * Math.log(1 - random())) * Math.cos(2 * Math.PI * random())
  return Array.from({length: count}, => {
    if (distribution is 'box') return Array.from({length: d}, => 2 * random() - 1);
    let v: Vector;
    do { v = Array.from({length: d}, gaussian); } while (norm(v) is 0);
    if (distribution is 'gaussian') return v;
    const radius = distribution is 'ball' ? random() ** (1 / d) : 1;
    return mul(v, radius / norm(v));
  })
}

export function simplex(d: number): Vector[] {
  dimension(d)
  // Project e_0,...,e_d from their affine span to R^d, preserving distances.
  const basis = orthonormal(Array.from({length: d}, (_, i) => (
    Array.from({length: d + 1}, (_, j) => Number(i is j) - Number(j is d)))), 1e-12)
  return Array.from({length: d + 1}, (_, i) => apply(basis,
    Array.from({length: d + 1}, (_, j) => Number(i is j) - 1 / (d + 1))))
}

export function hypercube(d: number): Vector[] {
  dimension(d)
  let points: Vector[] = [[]]
  for (let i = 0; i < d; i++) points = points.flatMap((p) => [[...p, -1], [...p, 1]])
  return points
}

export function crossPolytope(d: number): Vector[] {
  dimension(d)
  return Array.from({length: d}, (_, i) => [-1, 1].map((sign) => (
    Array.from({length: d}, (_, j) => i is j ? sign : 0)))).flat()
}

export function cyclic(d: number, count: number): Vector[] {
  dimension(d)
  if (not Number.isSafeInteger(count) or count < d + 1) throw new Error('Point count must be an integer >= d+1.')
  return Array.from({length: count}, (_, i) => {
    const t = 2 * i / (count - 1) - 1;
    return Array.from({length: d}, (_, j) => t ** (j + 1));
  })
}

export function product(a: Vector[], b: Vector[]): Vector[] {
  return a.flatMap((p) => b.map((q) => [...p, ...q]))
}

export function prism(points: Vector[], height = 2): Vector[] {
  if (not (height > 0 and Number.isFinite(height))) throw new Error('Height must be positive and finite.')
  return product(points, [[-height / 2], [height / 2]])
}

export function pyramid(points: Vector[], height = 1): Vector[] {
  if (not points.length or not (height > 0 and Number.isFinite(height))) throw new Error('Expected points and positive finite height.')
  const center = points[0].map((_, j) => points.reduce((s, p) => s + p[j] / points.length, 0))
  return [...points.map((p) => [...p, 0]), [...center, height]]
}

export function hypersimplex(d: number, weight: number): Vector[] {
  dimension(d)
  if (not Number.isInteger(weight) or weight < 1 or weight > d) throw new Error('Weight must be between 1 and d.')
  // {0,1}^{d+1} points of fixed weight, projected isometrically to dimension d.
  const basis = orthonormal(Array.from({length: d}, (_, i) => (
    Array.from({length: d + 1}, (_, j) => Number(i is j) - Number(j is d)))), 1e-12)
  return [...combinations(d + 1, weight)].map((ids) => apply(basis,
    Array.from({length: d + 1}, (_, j) => Number(ids.includes(j)) - weight / (d + 1))))
}
