// Small, dimension-independent numerical primitives. Vectors are column vectors.
export type Vector = number[]
export type Matrix = number[][]

export function dot(a: Vector, b: Vector): number
  sum .= 0
  for (i of [0..<a#]) sum += a[i] * b[i]
  sum

export function add(a: Vector, b: Vector): Vector
  a.map (x, i) => x + b[i]

export function sub(a: Vector, b: Vector): Vector
  a.map (x, i) => x - b[i]

export function mul(a: Vector, s: number): Vector
  a.map (x) => x * s

export function norm(a: Vector): number
  Math.hypot ...a

export function apply(a: Matrix, x: Vector): Vector
  a.map dot ., x

export function mean(points: Vector[]): Vector
  points[0].map (_, j) => points.reduce (s, p) => s + p[j] / points#, 0

export function unit(a: Vector, eps: number): Vector
  length := norm a
  throw new Error('Numerically degenerate direction; rescale or reduce tolerance.') if length <= eps
  mul a, 1 / length

export function residual(v: Vector, basis: Matrix): Vector
  r := [...v]
  orthogonalize r, basis
  r

function orthogonalize(r: Vector, basis: Matrix): void
  // Reorthogonalization matters for thin facets and nearly dependent input.
  for pass of [0..<2]
    for b of basis
      projection := dot r, b
      for (j of [0..<r#]) r[j] -= b[j] * projection

export function orthonormal(vectors: Matrix, eps: number): Matrix
  basis: Matrix := []
  for v of vectors
    r := residual v, basis
    basis.push unit r, eps if norm(r) > eps
  basis

export function affineBasis(points: Vector[], eps: number): Matrix
  points# ? orthonormal(points[>=1].map(sub(., points[0])), eps) : []

export function perpendicular(basis: Matrix, dimension: number, eps: number): Vector
  best: Vector .= []
  length .= 0
  r := Array(dimension).fill(0) as Vector
  for i of [0..<dimension]
    r.fill(0); r[i] = 1
    orthogonalize r, basis
    candidateLength := norm r
    if candidateLength > length
      best = [...r]
      length = candidateLength

  unit best, eps

export function* combinations(n: number, k: number): Generator<number[]>
  return if k < 0 or k > n
  indices := Array.from length: k, (_, i) => i
  loop
    yield [...indices]
    i .= k - 1
    while i >= 0 and indices[i] is n - k + i
      i--
    return if i < 0
    indices[i]++
    for (j of [i + 1..<k]) indices[j] = indices[j - 1] + 1

// Gaussian elimination with partial pivoting; null means numerically singular.
export function solveLinear(matrix: Matrix, rhs: Vector, eps: number): Vector | null
  n := rhs#
  a := matrix.map (row, i) => [...row, rhs[i]]
  for col of [0..<n]
    pivot .= col
    for row of [col + 1..<n]
      pivot = row if Math.abs(a[row][col]) > Math.abs a[pivot][col]
    return null if Math.abs(a[pivot][col]) <= eps
    [a[col], a[pivot]] = [a[pivot], a[col]]
    for row of [col + 1..<n]
      ratio := a[row][col] / a[col][col]
      for (j of [col..n]) a[row][j] -= ratio * a[col][j]
  x := Array(n).fill 0
  for row of [n>..>=0]
    value .= a[row][n]
    for (j of [row + 1..<n]) value -= a[row][j] * x[j]
    x[row] = value / a[row][row]
  x.every(Number.isFinite) ? x : null
