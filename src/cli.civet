{appendFileSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, realpathSync, writeFileSync} from node:fs
{dirname, join, resolve, sep} from node:path
{hostname} from node:os
{branchOrders, hullMethods, overlapMethods, convexHull, crossPolytope, cyclic, hypercube, hypersimplex, randomPoints, simplex, solve} from ./index.civet
type {Distribution, HullOptions, Polytope, SolveOptions, SolveResult} from ./index.civet
type {Vector} from ./linalg.civet
{formatSummary, summarizeResults} from ./summary.civet
{formatTimings, summarizeTimings} from ./timings.civet
{trialJSON} from ./storage.civet
{compactResults} from ./compact.civet
{retryCoverage} from ./retry-coverage.civet
type {CoverageRun} from ./retry-coverage.civet
{missingTasks, nextSearchSeed, taskInput, trialName, trialStatuses, withSeedLock} from ./jobs.civet
type {GeneratorSpec, TrialTask} from ./jobs.civet

help := `Usage: pnpm exec civet src/cli.civet <generate|solve|search|retry|summary|timings|compact> [input.json|directory] [options]

generate  Write {points, generator} JSON, to stdout or --output FILE.
solve     Read points from input.json, or generate them with the options below.
search    Search successive random seeds; save every trial in a new run directory.
retry     Resume missing trials and rerun inconclusive trials into one new run.
          Usage: retry DIRECTORY [DIRECTORY ...] [options]
          Default output parent is the first directory's parent.
          Reuse saved points and settings; reset all work limits to Infinity.
          Explicit solver/geometry options override saved settings.
summary   Summarize runs recursively in a directory (default results).
compact   Compact completed trial files recursively (default results).
          Usage: compact [DIRECTORY ...] [--dry-run]. Safe to repeat during jobs.
timings   Search-time or --nodes percentiles and tail counts (default results).
          --by-run keeps individual runs separate; --json exports raw values.

Generation options:
  --family NAME        random (default), simplex, cube, cross, cyclic, hypersimplex
  --dimension N        Ambient dimension >= 2 (default 4)
  --points N           Number of random/cyclic points (default dimension+3)
  --seed N             Starting seed (search: auto after matching runs; otherwise 0)
  --distribution NAME  sphere (default), ball, gaussian, box
  --weight N           Hypersimplex weight in dimension+1 coordinates (default 2)
  --scales X,Y,...     Positive axis scale factors (default all 1)

Geometry and solver options:
  --tolerance X        Hull tolerance after normalization (default 1e-9)
  --overlap-method NAME dual-lp (default), enumerate, primal-lp, gjk-lp
  --overlap-tolerance X  Interior margin in normalized units (default 16*tolerance)
  --hull-method NAME   incremental (default) or enumerate
  --max-hull-combinations N  Candidate-plane work limit (default Infinity)
  --max-nodes N        Tree search work limit (default Infinity)
  --timeout-ms N       Per-polytope tree search time (default Infinity)
  --root N             Root facet index (default 0)
  --all                Count all nonoverlapping trees instead of stopping at first
  --no-prune           Check overlap only on complete trees (for cross-checking)
  --forward-check MODE auto (default), on, off; auto starts after 2*facets nodes
  --no-force-bridges   Disable forced frontier bridges (enabled by default)
  --branch-order NAME  constrained (default), index, bottleneck

Output and search options:
  --output PATH        File for generate/solve/summary/timings; parent for search/retry
  --json               Machine-readable summary or timings instead of a text table
  --by-run             Separate timing distributions for each run
  --include-timeouts   Include timed-out attempts in timing reports
  --nodes              Report search-node counts instead of times
  --full-output        Include developed placements and pretty-print trial JSON
                       (automatic for no-unfolding counterexample candidates)
  --dry-run            Preview compact savings without changing files
                       or preview retry selection without starting a run
  --coverage-root DIR  Look for retry results under DIR (default source parents)
  --ignore-coverage    Retry original missing/inconclusive trials regardless of
                       results in other runs (retry only)
  --trials N           Number of random polytopes in search (default 100)
  --help               Show this help

Input: a coordinate array, {points: [...]}, or a previous solve/search result.
Statuses: found, no-unfolding (exhausted numerical candidate), inconclusive (limit).
Boundary contact is permitted. Floating-point results are not certified proofs.
Timeout covers tree search; hull construction has a separate combination limit.`

values := new Set ['family', 'dimension', 'points', 'seed', 'distribution', 'weight', 'scales', 'tolerance', 'hull-method', 'overlap-tolerance', 'overlap-method', 'max-hull-combinations', 'max-nodes', 'timeout-ms', 'root', 'output', 'trials', 'forward-check', 'branch-order', 'coverage-root']
switches := new Set ['help', 'all', 'no-prune', 'json', 'by-run', 'include-timeouts', 'nodes', 'no-force-bridges', 'full-output', 'dry-run', 'ignore-coverage']

function main(args: string[]): void
  flags := new Map<string, string>
  positional: string[] := []
  for i .= 0; i < args#; i++
    arg := args[i]
    unless arg.startsWith '--'
      positional.push arg
      continue

    [name, inline] := arg[>=2].split /=(.*)/s
    throw new Error(`Unknown option --${name}`) if not values.has(name) and not switches.has name
    throw new Error(`Duplicate option --${name}`) if flags.has name
    if switches.has name
      throw new Error(`--${name} does not take a value.`) if inline is not undefined
      flags.set name, 'true'
    else
      value := inline ?? args[++i]
      throw new Error(`Missing value for --${name}`) if not value or value.startsWith '--'
      flags.set name, value
  if flags.has('help') or not positional#
    console.log help
    return

  [command, file] := positional
  throw new Error('Invalid command or positional arguments. Use --help.') if command is not in ['generate', 'solve', 'search', 'retry', 'summary', 'timings', 'compact'] or positional# > (command is in ['retry', 'compact'] ? Infinity : command is in ['solve', 'summary', 'timings'] ? 2 : 1)
  if command is 'compact'
    for name of flags.keys() when name is not 'dry-run'
      throw new Error `--${name} does not apply to compact.`
    report := compactResults positional# > 1 ? positional[>=1] : ['results'], flags.has('dry-run'), (row) => console.error JSON.stringify row
    console.log JSON.stringify report
    return
  throw new Error('--dry-run only applies to compact or retry.') if flags.has('dry-run') and command is not 'retry'
  for name of ['coverage-root', 'ignore-coverage'] when flags.has(name) and command is not 'retry'
    throw new Error `--${name} only applies to retry.`
  throw new Error('--coverage-root and --ignore-coverage cannot be combined.') if flags.has('coverage-root') and flags.has 'ignore-coverage'
  throw new Error('--full-output only applies to solve, search, or retry.') if flags.has('full-output') and command is not in ['solve', 'search', 'retry']
  if command is 'timings'
    for name of flags.keys() when name is not in ['json', 'output', 'by-run', 'include-timeouts', 'nodes']
      throw new Error `--${name} does not apply to timings.`
    report := summarizeTimings file ?? 'results', flags.has('by-run'), flags.has('include-timeouts'), flags.has 'nodes'
    text := flags.has('json') ? JSON.stringify(report, null, 2) + '\n' : formatTimings report
    if flags.has 'output'
      writeFileSync flags.get('output')!, text

    else
      process.stdout.write text

    return
  throw new Error('--by-run only applies to timings.') if flags.has 'by-run'
  throw new Error('--include-timeouts only applies to timings.') if flags.has 'include-timeouts'
  throw new Error('--nodes only applies to timings.') if flags.has 'nodes'
  if command is 'summary'
    for name of flags.keys() when name is not in ['json', 'output']
      throw new Error `--${name} does not apply to summary.`
    summary := summarizeResults file ?? 'results'
    text := flags.has('json') ? JSON.stringify(summary, null, 2) + '\n' : formatSummary summary
    if flags.has 'output'
      writeFileSync flags.get('output')!, text

    else
      process.stdout.write text

    return
  throw new Error('--json only applies to summary or timings.') if flags.has 'json'
  if command is 'retry'
    throw new Error('retry requires a saved run directory.') unless file
    for name of ['family', 'dimension', 'points', 'seed', 'distribution', 'weight', 'scales', 'trials']
      throw new Error(`--${name} does not apply to retry; it reuses saved points.`) if flags.has name

  function number(name: string, fallback: number): number
    value := flags.has(name) ? Number(flags.get name) : fallback
    throw new Error(`--${name} must be a number.`) if Number.isNaN value
    value

  function integer(name: string, fallback: number, min: number): number
    value := number name, fallback
    throw new Error(`--${name} must be a safe integer >= ${min}.`) if not Number.isSafeInteger(value) or value < min
    value

  function limit(name: string, fallback: number, integral = true): number
    value := number name, fallback
    throw new Error(`Invalid --${name} limit.`) if not (value >= 0) or integral and value is not Infinity and not Number.isSafeInteger value
    value
  d := integer 'dimension', 4, 2
  count := integer 'points', d + 3, d + 1
  seed := integer 'seed', 0, Number.MIN_SAFE_INTEGER
  family := flags.get('family') ?? 'random'
  distribution := (flags.get('distribution') ?? 'sphere') as Distribution
  weight := integer 'weight', 2, 1
  scales := flags.has('scales') ? flags.get('scales')!.split(',').map(Number) : Array(d).fill 1
  throw new Error('--scales needs one positive finite factor per dimension.') if scales# is not d or scales.some (x) => not (x > 0 and Number.isFinite x)

  function generate(currentSeed: number): {points: Vector[]; generator: GeneratorSpec}
    let points: Vector[]
    switch family
      when 'random'
        points = randomPoints d, count, currentSeed, distribution
      when 'simplex'
        points = simplex d
      when 'cube'
        points = hypercube d
      when 'cross'
        points = crossPolytope d
      when 'cyclic'
        points = cyclic d, count
      when 'hypersimplex'
        points = hypersimplex d, weight
      else
        throw new Error `Unknown family: ${family}`

    points: points.map((p) => p.map (x, j) => x * scales[j]), generator: {family, dimension: d, count: points#, seed: currentSeed, distribution, weight, scales}

  function json(value: unknown): string
    JSON.stringify(value, (_, v) => v is Infinity ? 'Infinity' : v, 2) + '\n'

  function output(value: unknown, trial = false): void
    text := trial ? trialJSON(value, flags.has 'full-output') : json value
    if flags.has 'output'
      writeFileSync flags.get('output')!, text

    else
      process.stdout.write text

  if command is 'generate'
    output generate seed
    return

  hullMethod := flags.get('hull-method') ?? 'incremental'
  throw new Error('Invalid --hull-method.') unless hullMethod is in hullMethods as readonly string[]
  hullOptions: HullOptions := method: hullMethod as HullOptions['method'], tolerance: number('tolerance', 1e-9), maxCombinations: limit 'max-hull-combinations', Infinity
  throw new Error('--tolerance must be between 0 and 0.01.') unless (hullOptions.tolerance! > 0 and hullOptions.tolerance! < .01)
  overlapMethod := flags.get('overlap-method') ?? 'dual-lp'
  throw new Error('Invalid --overlap-method.') unless String(overlapMethod) is in overlapMethods as readonly string[]
  forwardMode := flags.get('forward-check') ?? 'auto'
  throw new Error('Invalid --forward-check.') unless forwardMode is in ['auto', 'on', 'off']
  branchOrder := flags.get('branch-order') ?? 'constrained'
  throw new Error('Invalid --branch-order.') unless branchOrder is in branchOrders as readonly string[]
  solveOptions: SolveOptions :=
    overlapMethod: overlapMethod as SolveOptions['overlapMethod']
    forwardCheck: forwardMode is 'auto' ? 'auto' : forwardMode is 'on'
    forceBridges: not flags.has('no-force-bridges'), branchOrder: branchOrder as SolveOptions['branchOrder']
    root: integer('root', 0, 0), maxNodes: limit 'max-nodes', Infinity
    timeoutMs: limit 'timeout-ms', Infinity, false
    overlapTolerance: flags.has('overlap-tolerance') ? number('overlap-tolerance', 0) : undefined
    stopAfterFirst: not flags.has('all'), pruneOverlaps: not flags.has 'no-prune'
  throw new Error('--overlap-tolerance must be positive and finite.') if solveOptions.overlapTolerance is not undefined and not (solveOptions.overlapTolerance > 0 and Number.isFinite solveOptions.overlapTolerance)

  function document(input: {points: Vector[]; generator?: unknown}, poly: Polytope, result: SolveResult, usedHull = hullOptions, usedSolve = solveOptions): object
    return {
      formatVersion: 1, input.{points, generator}, hullOptions: usedHull, solveOptions: usedSolve
      polytope: {
        poly.{dimension, center, scale, tolerance, hullCombinations, hullMethod, hullFallback},
        facets: poly.facets.map .vertices
        ridges: poly.ridges.map (r) => r.{facets, vertices}
      }
      result
    }
  if command is 'solve'
    raw := file ? JSON.parse(readFileSync file, 'utf8') : generate seed
    input := Array.isArray(raw) ? points: raw : raw
    poly := convexHull input?.points, hullOptions
    output document(input, poly, solve poly, solveOptions), true
    return
  let jobs: Iterable<TrialTask>
  let metadata: object
  let directory: string?
  parent := flags.get('output') ?? (command is 'retry' ? dirname(resolve file!) : 'results')
  if command is 'retry'
    sourceDirectories := [...new Map(positional[>=1].map (path) =>
      full := realpathSync path
      [process.platform is 'win32' ? full.toLowerCase() : full, full] as const
    ).values()]
    selected: TrialTask[] := []
    missing .= 0
    inconclusive .= 0
    skippedResolved .= 0; skippedDuplicates .= 0

    function canonical(path: string): string
      process.platform is 'win32' ? resolve(path).toLowerCase() : resolve path
    roots := flags.has('coverage-root') ? [realpathSync flags.get('coverage-root')!] : sourceDirectories.map dirname .
    // Include the selected sources even when an explicit coverage root is elsewhere.
    allRoots := [...new Set [...roots, ...sourceDirectories].map canonical].sort (a, b) => a# - b#
    coverageDirectories: string[] := []
    for root of allRoots when not coverageDirectories.some (parent) => root is parent or root.startsWith parent.endsWith(sep) ? parent : parent + sep
      coverageDirectories.push root
    let coverage: ReturnType<typeof retryCoverage>?
    unless flags.has 'ignore-coverage'
      runs: CoverageRun[] := []; links: [string, string][] := []
      console.error `Checking retry coverage in ${coverageDirectories.join ', '}`
      for root of coverageDirectories
        summary := summarizeResults root, undefined, (r, l) =>
          for (run of r) runs.push run
          for (link of l) links.push link;

        for (warning of summary.warnings) console.error warning
      coverage = retryCoverage runs, links
    selectedIdentities := new Set<string>

    function include(file: string): boolean
      if coverage?.isResolved file
        skippedResolved++
        return false

      id := coverage?.identity(file) ?? canonical file
      if coverage and selectedIdentities.has id
        skippedDuplicates++
        return false

      selectedIdentities.add id
      true

    function enqueue(task: TrialTask, effectiveOverlap?: number): void
      usedHull: HullOptions :=
        method: flags.has('hull-method') ? hullOptions.method : task.hullOptions.method ?? hullOptions.method
        tolerance: flags.has('tolerance') ? hullOptions.tolerance : task.hullOptions.tolerance ?? hullOptions.tolerance
        maxCombinations: hullOptions.maxCombinations
      usedSolve: SolveOptions := {
        ...solveOptions
        overlapMethod: flags.has('overlap-method') ? solveOptions.overlapMethod : task.solveOptions.overlapMethod ?? solveOptions.overlapMethod
        forwardCheck: flags.has('forward-check') ? solveOptions.forwardCheck : task.solveOptions.forwardCheck ?? solveOptions.forwardCheck
        forceBridges: flags.has('no-force-bridges') ? false : task.solveOptions.forceBridges ?? solveOptions.forceBridges
        branchOrder: flags.has('branch-order') ? solveOptions.branchOrder : task.solveOptions.branchOrder ?? solveOptions.branchOrder
        root: flags.has('root') ? solveOptions.root : task.solveOptions.root ?? solveOptions.root
        overlapTolerance: flags.has('overlap-tolerance') ? solveOptions.overlapTolerance : task.solveOptions.overlapTolerance ?? effectiveOverlap
        stopAfterFirst: flags.has('all') ? false : task.solveOptions.stopAfterFirst ?? true
        pruneOverlaps: flags.has('no-prune') ? false : task.solveOptions.pruneOverlaps ?? true
      }
      name := sourceDirectories# is 1 ? task.name : `trial-${String(selected#).padStart 6, '0'}.json`
      selected.push {...task, name, hullOptions: usedHull, solveOptions: usedSolve}
    for sourceDirectory of sourceDirectories
      entries := readdirSync(sourceDirectory, withFileTypes: true).sort (a, b) => a.name < b.name ? -1 : 1
      files := new Set entries.filter((e) => e.isFile()).map(.name)
      {statuses, invalidRows} := trialStatuses sourceDirectory
      console.error `${sourceDirectory}: ignored ${invalidRows} invalid journal rows; checking unindexed trial files.` if invalidRows
      // Finish unattempted seeds before revisiting potentially expensive cutoffs.
      for task of missingTasks sourceDirectory, files, (name) => include join sourceDirectory, name
        enqueue task
        missing++

      // Completed indexed trials need no coordinate-file reads. Verify selected
      // trials and inspect unindexed files in case the journal was not flushed.
      for entry of entries
        continue if not entry.isFile() or not /^trial-.*\.json$/.test entry.name
        status := statuses.get entry.name
        continue if status is not undefined and status is not 'inconclusive'
        sourceFile := join sourceDirectory, entry.name
        continue if status is 'inconclusive' and not include sourceFile
        if status is undefined and coverage?.isResolved sourceFile
          skippedResolved++
          continue

        saved := JSON.parse readFileSync sourceFile, 'utf8'
        continue if saved?.result?.status is not 'inconclusive'
        continue if status is undefined and not include sourceFile
        enqueue {input: {saved.{points, generator}}, entry.name,
          saved.generator, saved.generator?.seed, sourceFile
          hullOptions: saved.hullOptions ?? {saved.polytope?.tolerance}, solveOptions: saved.solveOptions ?? {}}, saved.result.overlapTolerance
        inconclusive++
    console.error `Skipped ${skippedResolved} resolved trials and ${skippedDuplicates} duplicate selections.` if skippedResolved or skippedDuplicates
    if flags.has 'dry-run'
      console.log JSON.stringify {sourceDirectories, coverageDirectories: coverage ? coverageDirectories : [], trials: selected#, missing, inconclusive, skippedResolved, skippedDuplicates}
      return
    unless (selected#)
      console.error `No inconclusive trials or missing trials remain in ${sourceDirectories.join ', '}`
      return

    console.error `Retrying ${inconclusive} inconclusive trials and resuming ${missing} missing trials from ${sourceDirectories.join ', '}`
    jobs = selected
    metadata = {command, sourceDirectory: sourceDirectories# is 1 ? sourceDirectories[0] : undefined,
      sourceDirectories, trials: selected#, sourceFiles: selected.map(.sourceFile), overrides: Object.fromEntries flags
      tasks: selected.map ({input, ...task}) => task}
  else
    throw new Error('search uses random polytopes; use solve for a fixed family.') if family is not 'random'
    trials := integer 'trials', 100, 1
    throw new Error('Seed range exceeds safe integers.') unless Number.isSafeInteger seed + trials - 1
    allocation := withSeedLock parent, =>
      spec: GeneratorSpec := {family, dimension: d, count, seed, distribution, weight, scales}
      startSeed := flags.has('seed') ? seed : nextSearchSeed parent, spec, trials
      throw new Error('Seed range exceeds safe integers.') unless Number.isSafeInteger startSeed + trials - 1
      firstInput := generate startSeed
      metadata := {command, trials, seed: startSeed, firstInput.generator, hullOptions, solveOptions}
      directory := mkdtempSync join parent, 'run-'
      writeFileSync join(directory, 'run.json'), json {formatVersion: 1, ...metadata, worker: pid: process.pid, hostname: hostname(), startedAt: (new Date).toISOString()}
      {startSeed, firstInput, metadata, directory}

    {startSeed, firstInput} := allocation
    directory = allocation.directory
    metadata = allocation.metadata
    console.error `Seeds ${startSeed} through ${startSeed + trials - 1}${flags.has('seed') ? '' : ' (automatically allocated)'}`
    jobs = (function* (): Generator<TrialTask>
      for i of [0..<trials]
        yield {input: i is 0 ? firstInput : generate(startSeed + i), seed: startSeed + i,
          name: trialName(i, startSeed + i), hullOptions, solveOptions}
    )()
  unless directory
    mkdirSync parent, recursive: true
    directory = mkdtempSync join parent, 'retry-'
    writeFileSync join(directory, 'run.json'), json {formatVersion: 1, ...metadata, worker: pid: process.pid, hostname: hostname(), startedAt: (new Date).toISOString()}
  console.error `Saving trials to ${directory} (PID ${process.pid})`
  totals := found: 0, candidates: 0, inconclusive: 0, errors: 0
  i .= 0
  for job of jobs
    {name, sourceFile, hullOptions: usedHull, solveOptions: usedSolve} := job
    input := taskInput job
    provenance := {trial: i++, job.seed, sourceFile}
    let record: object
    let summary: object
    try
      poly := convexHull input.points, usedHull
      result := solve poly, usedSolve
      switch result.status
        when 'found'
          totals.found++
        when 'no-unfolding'
          totals.candidates++
        else
          totals.inconclusive++

      record = {...document(input, poly, result, usedHull, usedSolve), sourceFile}
      summary = {...provenance, result.{status, termination}, facets: poly.facets#, ridges: poly.ridges#, ...result.stats}
    catch (error)
      totals.errors++
      message := error instanceof Error ? error.message : String error
      record = {formatVersion: 1, ...input, sourceFile, hullOptions: usedHull, solveOptions: usedSolve, error: message}
      summary = {...provenance, status: 'error', error: message}
    writeFileSync join(directory, name), trialJSON(record, flags.has 'full-output'), flag: 'wx'
    line := JSON.stringify {...summary, file: name}
    appendFileSync join(directory, 'trials.jsonl'), line + '\n'
    console.log JSON.stringify {...summary, file: name, outputFile: resolve(directory, name), process.pid}
  writeFileSync join(directory, 'summary.json'), json totals
  console.error JSON.stringify {...totals, outputFile: resolve(directory, 'summary.json'), process.pid}
  console.error `Results saved to ${directory}`

try
  main process.argv[>=2]
catch (error)
  console.error error instanceof Error ? error.message : String error
  process.exitCode = 1
