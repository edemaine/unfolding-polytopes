{add, apply, combinations, dot, mean, mul, solveLinear, sub, unit} from ./linalg.civet
type {Matrix, Vector} from ./linalg.civet
{primalWitness, gjkSeparated, supportSeparates, halfspaceLP} from ./primal.civet
type {Polytope} from ./polytope.civet

export interface Halfspace
  normal: Vector
  offset: number

export interface Placement
  facet: number
  linear: Matrix
  translation: Vector
  vertices: number[]
  coordinates: Vector[]
  halfspaces: Halfspace[]
  min: Vector
  max: Vector

export function mapPoint(placement: Placement, point: Vector): Vector
  add apply(placement.linear, point), placement.translation

function placement(poly: Polytope, facet: number, linear: Matrix, translation: Vector): Placement
  face := poly.facets[facet]
  coordinates := face.vertices.map (i) => add apply(linear, poly.points[i]), translation
  halfspaces := face.ridges.map (id) =>
    ridge := poly.ridges[id]
    side := ridge.facets[0] is facet ? 0 : 1
    normal := unit mul(apply(linear, ridge.inward[side]), -1), poly.tolerance
    offset := dot normal, add apply(linear, poly.points[ridge.vertices[0]]), translation
    {normal, offset}

  min := coordinates[0].map (_, j) => Math.min ...coordinates.map (p) => p[j]
  max := coordinates[0].map (_, j) => Math.max ...coordinates.map (p) => p[j]
  {facet, linear, translation, vertices: [...face.vertices], coordinates, halfspaces, min, max}

export function rootPlacement(poly: Polytope, root = 0): Placement
  throw new Error 'Invalid root facet.' if not Number.isInteger(root) or root < 0 or root >= poly.facets#
  linear := poly.facets[root].basis
  placement poly, root, linear, mul apply(linear, poly.points[poly.facets[root].vertices[0]]), -1

export function attachFacet(poly: Polytope, parent: Placement, ridgeId: number): Placement
  ridge := poly.ridges[ridgeId]
  throw new Error('Ridge is not incident to parent facet.') if not ridge or parent.facet is not in ridge.facets
  side := ridge.facets[0] is parent.facet ? 0 : 1
  child := ridge.facets[1 - side]
  along := ridge.basis.map apply parent.linear, .
  across := apply parent.linear, ridge.inward[side]
  // Fix the ridge pointwise and send the child's inward direction to the
  // negative of the parent's inward direction. This unfolds the hinge flat.
  linear := Array.from length: poly.dimension - 1, (_, i) =>
    Array.from length: poly.dimension, (_, j) =>
      ridge.basis.reduce (sum, v, k) => sum + along[k][i] * v[j], 0
      - across[i] * ridge.inward[1 - side][j]
  anchor := poly.points[ridge.vertices[0]]
  translation := sub mapPoint(parent, anchor), apply linear, anchor
  placement poly, child, linear, translation

// Is there x strictly inside both convex facets? Maximize t subject to
// n_i . x + t <= b_i for all unit outward normals of both facets. A positive
// optimum is equivalent to full-dimensional intersection. The bounded facets
// ensure an optimal vertex in (x,t); enumerate its k+1 active constraints.
// This works in any dimension, including configurations where no vertex of
// either facet lies in the other. Boundary contact is allowed.
export overlapMethods := ['enumerate', 'primal-lp', 'gjk-lp', 'dual-lp'] as const
export type OverlapMethod = typeof overlapMethods[number]
export interface OverlapStats
  calls: number
  primalWitnesses: number
  supportSeparations: number
  fallbacks: number


export function interiorOverlap(a: Placement, b: Placement, tolerance: number, poll: => void = => return, method: OverlapMethod = 'dual-lp', stats?: OverlapStats): boolean
  stats.calls++ if stats
  throw new Error('Unknown overlap method.') unless method is in overlapMethods
  k := a.min#
  throw new Error('Cannot intersect different dimensions.') if b.min# is not k
  for i of [0..<k]
    return false if Math.min(a.max[i], b.max[i]) - Math.max(a.min[i], b.min[i]) <= tolerance
  planes := [...a.halfspaces, ...b.halfspaces]

  function inside(x: Vector): boolean
    planes.every (p) => p.offset - dot(p.normal, x) > tolerance
  return true if inside(mean a.coordinates) or inside mean b.coordinates
  if method.startsWith 'dual-'
    result := halfspaceLP a, b, tolerance, poll
    if result and inside result.point
      stats.primalWitnesses++ if stats
      return true
    if result?.separated
      stats.supportSeparations++ if stats
      return false
    stats.fallbacks++ if stats
  else if method is not 'enumerate'
    if method.startsWith('gjk-') and gjkSeparated a, b, tolerance, poll
      stats.supportSeparations++ if stats
      return false
    witness := primalWitness a, b, poll
    if witness?.point and inside witness.point
      stats.primalWitnesses++ if stats
      return true
    if witness and supportSeparates a, b, witness.direction, tolerance
      stats.supportSeparations++ if stats
      return false
    if method.startsWith('primal-') and gjkSeparated a, b, tolerance, poll
      stats.supportSeparations++ if stats
      return false
    // Barycentric and geometric margins differ. Retain the original geometric
    // decision for shallow overlaps, failed pivots, or GJK stagnation.
    stats.fallbacks++ if stats
  iterations .= 0
  for ids of combinations planes#, k + 1
    poll() if iterations++ % 256 is 0
    solution := solveLinear ids.map((i) => [...planes[i].normal, 1]), ids.map((i) => planes[i].offset), 1e-13
    // Re-evaluate all actual inequalities instead of trusting the computed t.
    return true if solution and inside solution[<k]
  false

export function developTree(poly: Polytope, tree: number[], root = 0): Placement[]
  if tree# is not poly.facets# - 1 or new Set(tree).size is not tree# or tree.some (id) => not Number.isInteger(id) or not poly.ridges[id]
    throw new Error 'Expected distinct ridge IDs forming a spanning tree.'
  placements := new Map<number, Placement> [[root, rootPlacement poly, root]]
  queue := [root]
  for i .= 0; i < queue#; i++
    f := queue[i]
    for id of tree
      ridge := poly.ridges[id]
      continue unless f is in ridge.facets
      child := ridge.facets[0] is f ? ridge.facets[1] : ridge.facets[0]
      unless placements.has child
        placements.set child, attachFacet poly, placements.get(f)!, id
        queue.push child
  throw new Error 'Ridge IDs do not form a spanning tree.' if placements.size is not poly.facets#
  [...placements.values()].sort (a, b) => a.facet - b.facet
