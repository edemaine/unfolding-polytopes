{affineBasis, dot, mean, mul, norm, perpendicular, residual, sub, unit} from ./linalg.civet
type {Vector, Matrix} from ./linalg.civet

export class HullPrecisionError extends Error {}
interface SimplexFace
  id: number
  vertices: number[]
  basis: Matrix
  normal: Vector
  offset: number
  keys: string[]

export interface HullBoundary
  faces: SimplexFace[]
  adjacency: [number, number][] // Indices into faces, including coplanar neighbors.

// Beneath-beyond on a triangulated boundary. Coplanar boundary simplices are
// allowed here; the caller merges supporting planes into true facets.
export function incrementalHull(points: Vector[], eps: number, consume: => void): HullBoundary
  d := points[0]#
  seed := [0]; basis: Matrix := []
  while seed# <= d
    best .= -1; distance .= eps; direction: Vector .= []
    for i of [0..<points#]
      continue if i is in seed
      r := residual(sub(points[i], points[0]), basis); length := norm r
      if length > distance
        best = i
        distance = length
        direction = r

    throw new HullPrecisionError('Cannot select a stable initial simplex.') if best < 0
    seed.push(best); basis.push unit direction, eps
  // This point stays strictly inside every subsequent hull, fixing orientation.
  interior := mean seed.map (i) => points[i]
  faces := new Map<number, SimplexFace>
  incidence := new Map<string, Set<number>>
  nextId .= 0
  function add(vertices: number[]): void
    consume()
    vertices.sort (a, b) => a - b
    span := affineBasis vertices.map((i) => points[i]), eps
    throw new HullPrecisionError('Degenerate incremental boundary simplex.') if span# is not d - 1
    normal .= perpendicular(span, d, eps); offset .= dot normal, points[vertices[0]]
    side := dot(normal, interior) - offset
    throw new HullPrecisionError('Ambiguous incremental facet orientation.') if Math.abs(side) <= eps
    if side > 0
      normal = mul normal, -1
      offset = -offset

    keys := vertices.map (_, omitted) => vertices.filter((_, j) => j is not omitted).join ','
    id := nextId++
    faces.set id, {id, vertices, basis: span, normal, offset, keys}
    for key of keys
      incidence.set key, new Set unless incidence.has key
      incidence.get(key)!.add id
      throw new HullPrecisionError('Nonmanifold incremental boundary.') if incidence.get(key)!.size > 2
  for (i of [0..<seed#]) add seed.filter (_, j) => j is not i
  for point of [0..<points#]
    continue if point is in seed
    visible := new Set<number>
    for face of faces.values() when dot(face.normal, points[point]) - face.offset > eps
      visible.add face.id
    continue unless visible.size // Interior, duplicate, or on the existing boundary.
    horizon := new Map<string, number[]>
    for id of visible
      face := faces.get(id)!
      for each key, j of face.keys
        neighbors := incidence.get(key)!
        throw new HullPrecisionError('Open incremental boundary.') if neighbors.size is not 2
        if ([...neighbors].some (other) => not visible.has other) horizon.set key, face.vertices.filter (_, i) => i is not j
    throw new HullPrecisionError('Incremental horizon is empty.') unless horizon.size
    for id of visible
      for key of faces.get(id)!.keys
        owners := incidence.get(key)!; owners.delete id
        incidence.delete key unless owners.size
      faces.delete id
    for (vertices of horizon.values()) add [...vertices, point]
    for owners of incidence.values() when owners.size is not 2
      throw new HullPrecisionError 'Open incremental boundary after insertion.'
  boundary := [...faces.values()]
  indices := new Map boundary.map (face, i) => [face.id, i]
  adjacency: [number, number][] := []
  for owners of incidence.values()
    throw new HullPrecisionError('Open final incremental boundary.') if owners.size is not 2
    [a, b] := [...owners]
    adjacency.push [indices.get(a)!, indices.get(b)!]
  {faces: boundary, adjacency}
