{readFileSync, readdirSync} from node:fs
{dirname, join, relative, resolve} from node:path
{hostname} from node:os
{retryCoverage} from ./retry-coverage.civet
type {CoverageRun, RetryCoverage} from ./retry-coverage.civet

export interface Counts
  trials: number
  found: number
  candidates: number
  inconclusive: number
  errors: number
  unreadable: number
  timeouts: number
  nodeLimits: number
  searchMs: number

export interface RunSummary extends Counts
  directory: string
  kind: string
  dimension: number | null
  points: number | null
  expected: number | null
  remaining: number | null
  finished: boolean
  state: 'finished' | 'running' | 'interrupted' | 'unknown'
  pid: number | null
  retryCoverage: RetryCoverage

export interface ResultsSummary
  directory: string
  runs: RunSummary[]
  groups: GroupSummary[]
  totals: Counts
  warnings: string[]

export interface GroupSummary extends Counts
  dimension: number | null
  points: number | null
  runCount: number
  finishedRuns: number
  expected: number | null
  remaining: number | null

function counts(): Counts
  return trials: 0, found: 0, candidates: 0, inconclusive: 0, errors: 0, unreadable: 0, timeouts: 0, nodeLimits: 0, searchMs: 0

function nonnegative(n: unknown): n is number
  n <? 'number' and Number.isFinite(n) and n >= 0

function compareParameter(a: number | null, b: number | null): number
  a is b ? 0 : a is null ? 1 : b is null ? -1 : a - b
statusKeys := new Map<string, 'found' | 'candidates' | 'inconclusive' | 'errors'> [
  ['found', 'found'], ['no-unfolding', 'candidates'], ['inconclusive', 'inconclusive'], ['error', 'errors']
]

function workerState(worker: any): 'running' | 'interrupted' | 'unknown'
  return 'unknown' if worker?.hostname is not hostname() or not Number.isSafeInteger(worker?.pid) or worker.pid <= 0
  try
    process.kill worker.pid, 0 // Existence probe; does not terminate the worker.
    'running'
  catch (error)
    (error as NodeJS.ErrnoException).code is 'ESRCH' ? 'interrupted' : 'unknown'

// Count saved attempts, including retries separately. Journals avoid parsing
// large coordinate files, but only rows with an existing trial file count.
export function summarizeResults(path = 'results', observeTrial?: (run: RunSummary, row: {file: string; sourceFile?: string; status: string; termination?: string; elapsedMs?: unknown; nodes?: unknown; generator?: any}, metadata: any) => void, collectCoverage?: (runs: CoverageRun[], links: [string, string][]) => void): ResultsSummary
  directory := resolve path
  result: ResultsSummary := {directory, runs: [], groups: [], warnings: [], totals: counts()}
  coverageRuns: CoverageRun[] := []
  retryLinks: [string, string][] := []
  type Parameters =
    dimension: number | null
    points: number | null

  unknown: Parameters := dimension: null, points: null
  sourceParameters := new Map<string, Parameters>

  function source(directory: string, visiting: Set<string>): Parameters
    key := process.platform is 'win32' ? resolve(directory).toLowerCase() : resolve directory
    return unknown if visiting.has key
    cached := sourceParameters.get key
    return cached if cached
    value .= unknown
    try
      metadata := JSON.parse readFileSync join(directory, 'run.json'), 'utf8'
      value = parameters metadata, new Set [...visiting, key]
    catch {}
    sourceParameters.set key, value
    value

  function parameters(metadata: any, visiting = new Set<string>): Parameters
    if (metadata?.generator) return
      dimension: nonnegative(metadata.generator.dimension) ? metadata.generator.dimension : null
      points: nonnegative(metadata.generator.count) ? metadata.generator.count : null
    let values: Parameters[]
    if Array.isArray(metadata?.tasks) and metadata.tasks#
      values = metadata.tasks.map (task: any) => task?.generator ? parameters task, visiting
        : task?.sourceFile <? 'string' ? source(dirname(task.sourceFile), visiting) : unknown
    else
      directories := Array.isArray(metadata?.sourceDirectories) and metadata.sourceDirectories# ? metadata.sourceDirectories
        : metadata?.sourceDirectory <? 'string' ? [metadata.sourceDirectory]
        : Array.isArray(metadata?.sourceFiles) ? metadata.sourceFiles.filter((file: unknown) => file <? 'string').map((file: string) => dirname file) : []
      values = [...new Set<string> directories.filter (value: unknown) => value <? 'string'].map source ., visiting
    // A retry can combine different parameters. Report only values shared by
    // every planned task/source, including tasks that have not run yet.
    return unknown unless values#
    first := values[0]
    {dimension: values.every((v) => v.dimension is first.dimension) ? first.dimension : null,
      points: values.every((v) => v.points is first.points) ? first.points : null}

  function scan(current: string): void
    entries := readdirSync(current, withFileTypes: true).sort (a, b) => a.name < b.name ? -1 : 1
    files := new Set entries.filter((e) => e.isFile()).map(.name)
    trials := [...files].filter /^trial-.*\.json$/.test .
    if files.has('run.json') or trials#
      metadata: any .= {}
      if files.has 'run.json'
        try
          metadata = JSON.parse(readFileSync join(current, 'run.json'), 'utf8') ?? {}
        catch
          result.warnings.push `Cannot parse ${join current, 'run.json'}`
      expected := Number.isSafeInteger(metadata.trials) and metadata.trials >= 0 ? metadata.trials : null
      run: RunSummary := {
        ...counts(), directory: current, kind: metadata.command ?? (metadata.sourceDirectory ? 'retry' : 'search')
        ...parameters metadata
        expected, remaining: expected is null ? null : Math.max 0, expected - trials#
        finished: files.has 'summary.json'
        state: files.has('summary.json') ? 'finished' : workerState metadata.worker
        pid: Number.isSafeInteger(metadata.worker?.pid) and metadata.worker.pid > 0 ? metadata.worker.pid : null
        retryCoverage: resolved: 0, remaining: expected, viaRetries: 0, complete: false, directories: [], inProgress: 0, duplicateAssignments: 0, unassigned: expected, workers: []
      }
      coverageRun := {directory: current, expected, metadata, saved: new Set(trials), resolved: new Set<string>, attempted: new Set<string>, run.{state, pid}}
      coverageRuns.push coverageRun
      journal := new Map<string, any>
      if files.has 'trials.jsonl'
        invalid .= 0
        for line of readFileSync(join(current, 'trials.jsonl'), 'utf8').split '\n'
          continue unless line.trim()
          try
            row := JSON.parse line
            if row?.file !<? 'string' or not /^trial-[^\\/]+\.json$/.test row.file
              invalid++
              continue

            unless statusKeys.has row.status
              journal.delete row.file
              invalid++
              continue

            // Repeated rows describe the same saved attempt; keep the last.
            journal.set row.file, row
          catch
            invalid++

        result.warnings.push `${join current, 'trials.jsonl'}: ignored ${invalid} invalid journal rows; using trial files where needed.` if invalid
      for name of trials
        run.trials++
        row .= journal.get name
        unless row
          try
            saved := JSON.parse readFileSync join(current, name), 'utf8'
            row = {file: name, saved?.sourceFile, saved?.generator, status: saved?.error is not undefined ? 'error' : saved?.result?.status,
              saved?.result?.termination, saved?.result?.stats?.elapsedMs, saved?.result?.stats?.nodes}
          catch
            run.unreadable++
            result.warnings.push `Cannot parse ${join current, name} (possibly still being written).`
            continue
        key := statusKeys.get row.status
        unless key
          run.unreadable++
          result.warnings.push `Unrecognized trial status in ${join current, name}`
          continue
        run[key]++
        coverageRun.attempted.add name
        coverageRun.resolved.add name if row.status is 'found' or row.status is 'no-unfolding'
        if (row.sourceFile <? 'string') retryLinks.push [join(current, name), row.sourceFile]
        observeTrial?.(run, row, metadata)
        run.timeouts++ if row.status is 'inconclusive' and row.termination is 'timeout'
        run.nodeLimits++ if row.status is 'inconclusive' and row.termination is 'maxNodes'
        run.searchMs += row.elapsedMs if nonnegative row.elapsedMs
      result.runs.push run
      for key of Object.keys(result.totals) as (keyof Counts)[] result.totals[key] += run[key]
    // Do not follow symlinks/junctions: avoid cycles and double counting.
    for entry of entries when entry.isDirectory() and not entry.isSymbolicLink()
      scan join current, entry.name
  scan directory
  collectCoverage?.(coverageRuns, retryLinks)
  coverage := retryCoverage coverageRuns, retryLinks
  for (run of result.runs) run.retryCoverage = coverage.runs.get(run.directory)!
  result.runs.sort (a, b) => compareParameter(a.dimension, b.dimension) or compareParameter(a.points, b.points)
    or (a.directory < b.directory ? -1 : a.directory > b.directory ? 1 : 0)
  for run of result.runs
    group .= result.groups.at -1
    if not group or group.dimension is not run.dimension or group.points is not run.points
      group = {...counts(), run.{dimension, points}, runCount: 0, finishedRuns: 0, expected: 0, remaining: 0}
      result.groups.push group
    group.runCount++
    group.finishedRuns++ if run.finished
    group.expected = group.expected is null or run.expected is null ? null : group.expected + run.expected
    group.remaining = group.remaining is null or run.remaining is null ? null : group.remaining + run.remaining
    for key of Object.keys(result.totals) as (keyof Counts)[] group[key] += run[key]
  result

function elapsedTime(ms: number): string
  // Round before splitting units so 59.95 seconds carries into the next minute.
  tenths .= Math.round ms / 100
  parts: string[] := []
  for [unit, size] of [['d', 864000], ['h', 36000], ['m', 600]] as const
    amount := Math.floor tenths / size
    parts.push `${amount}${unit}` if amount
    tenths %= size
  parts.push `${(tenths / 10).toFixed 1}s`
  parts.join ' '

export function formatSummary(summary: ResultsSummary): string
  t := summary.totals
  lines := [`Results: ${summary.directory}`, '']
  rows := [['Run', 'Kind', 'd', 'Points', 'Saved/Planned', 'Found', 'Candidate', 'Inconcl.', 'Error', 'Unread.', 'State', 'Retry coverage']]

  function row(label: string, kind: string, dimension: number | null, points: number | null, c: Counts, expected: number | null, state: string, coverage = '-'): string[]
    [
      label, kind, String(dimension ?? '-'), String(points ?? '-'), `${c.trials}/${expected ?? '?'}`
      String(c.found), String(c.candidates), String(c.inconclusive), String(c.errors), String(c.unreadable), state, coverage
    ]
  offset .= 0
  for group of summary.groups
    for run of summary.runs[offset..<offset + group.runCount]
      state := run.state is 'running' ? `running (PID ${run.pid})` : run.state
      c := run.retryCoverage
      pending := c.inProgress ? `${c.unassigned is 0 ? '' : `${c.unassigned ?? '?'} left, `}${c.inProgress} running` : `${c.remaining ?? '?'} left`
      coverage := c.viaRetries or c.inProgress ? `${c.complete ? 'complete' : 'partial'} (${c.viaRetries ? `+${c.viaRetries}; ` : ''}${pending})` : '-'
      rows.push row relative(summary.directory, run.directory) or '.', run.kind, run.dimension, run.points, run, run.expected, state, coverage
    offset += group.runCount
    if group.runCount > 1
      rows.push row `Subtotal (${group.runCount} runs)`, '-', group.dimension, group.points, group, group.expected, `${group.finishedRuns}/${group.runCount} finished`
    rows.push Array(rows[0]#).fill ''
  expected := summary.runs.some((r) => r.expected is null) ? null : summary.runs.reduce (n, r) => n + r.expected!, 0
  rows.push [...rows[0]] if summary.runs#
  rows.push row 'TOTAL', '-', null, null, t, expected, `${summary.runs.filter(.finished)#}/${summary.runs#} finished`
  widths := rows[0].map (_, i) => Math.max ...rows.map (row) => row[i]#
  lines.push ...rows.map (row) => row.map((cell, i) => cell.padEnd widths[i]).join('  ').trimEnd()
  if (summary.warnings#) lines.push '', ...summary.warnings.map (w) => `Warning: ${w}`
  lines.push '', `${summary.runs#} runs; ${t.trials} saved attempts (retries counted separately).`,
    'Retry coverage: found/candidate results in other scanned runs resolve source trials; +N counts additional resolved trials. Worker state and original counts are unchanged.',
    `Inconclusive limits: ${t.timeouts} timeout, ${t.nodeLimits} node limit. Recorded search time: ${elapsedTime t.searchMs}.`
  lines.join('\n') + '\n'
