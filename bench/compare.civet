assert from node:assert/strict
{median} from ./util.civet
{mkdirSync, readFileSync, writeFileSync} from node:fs
{resolve} from node:path
{pathToFileURL} from node:url
* as after from ../src/index.civet
type {BenchmarkCase} from ./fixtures.civet

throw new Error('Usage: pnpm bench:compare PATH_TO_REFERENCE_SRC') unless process.argv[2]
reference := resolve process.argv[2]
before := await import(pathToFileURL(resolve reference, 'index.civet').href) as typeof after
mkdirSync 'bench/output', recursive: true

cases := ['sampled', 'completed'].flatMap (suite) =>
  fixtures := JSON.parse(readFileSync `bench/${suite}-cases.json`, 'utf8') as BenchmarkCase[]
  fixtures.map (c) => name: `${c.generator.dimension}D n=${c.coordinates#} seed=${c.generator.seed}`, points: c.coordinates, hull: {...c.hullOptions, method: 'incremental' as const}, search: c.solveOptions, full: suite is 'completed'

for d of [4, 5]
  cases.push name: `cube ${d}D`, points: after.hypercube(d), hull: {method: 'incremental'}, search: {}, full: false
  cases.push name: `cross ${d}D`, points: after.crossPolytope(d), hull: {method: 'incremental'}, search: {}, full: false
versions := {before, after}
rows: object[] := []
for [index, item] of cases.entries()
  hulls := before: before.convexHull(item.points, item.hull), after: after.convexHull item.points, item.hull
  // The optimized primitives preserve arithmetic order, so require exact geometry.
  assert.deepEqual hulls.after, hulls.before, item.name
  assert.equal hulls.after.hullMethod, 'incremental', item.name
  elapsed := before: [] as number[], after: [] as number[]
  for round of [0..<5]
    for version of round % 2 ? ['after', 'before'] as const : ['before', 'after'] as const
      start := performance.now()
      versions[version].convexHull item.points, item.hull
      elapsed[version].push performance.now() - start
  limit := item.full ? Infinity : 80
  options := {...item.search, maxNodes: limit, timeoutMs: Infinity, overlapMethod: 'dual-lp' as const}
  searches := before: before.solve(hulls.before, options), after: after.solve hulls.after, options
  assert.equal searches.after.status, searches.before.status, item.name
  assert.deepEqual searches.after.tree, searches.before.tree, item.name
  assert.deepEqual {...searches.after.stats, elapsedMs: 0}, {...searches.before.stats, elapsedMs: 0}, item.name
  assert.deepEqual searches.after.overlapStats, searches.before.overlapStats, item.name
  searchTimes := before: [] as number[], after: [] as number[]
  if limit is Infinity
    for round of [0..<5]
      for version of round % 2 ? ['after', 'before'] as const : ['before', 'after'] as const
        result := versions[version].solve hulls[version], options
        searchTimes[version].push result.stats.elapsedMs

  rows.push {item.name, elapsed, searchTimes, beforeHullMs: median(elapsed.before), afterHullMs: median(elapsed.after), beforeSearchMs: median(searchTimes.before), afterSearchMs: median searchTimes.after}
  console.log `[${index + 1}/${cases#}] ${item.name}: hull ${(median(elapsed.before) / median elapsed.after).toFixed 2}x${limit is Infinity ? ` search ${(median(searchTimes.before) / median searchTimes.after).toFixed 2}x` : ''}`
writeFileSync 'bench/output/optimization-results.json', JSON.stringify({date: (new Date).toISOString(), node: process.version, reference, rounds: 5, rows}, null, 2) + '\n'
console.log `Exact hulls, search counts, witness trees, and overlap counters matched on all ${cases#} cases. Results: bench/output/optimization-results.json`
