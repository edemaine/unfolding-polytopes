"civet esCompat";
import assert from 'node:assert/strict';
import {mkdirSync, readFileSync, writeFileSync} from 'node:fs';
import {resolve} from 'node:path';
import {pathToFileURL} from 'node:url';
import * as after from '../src/index.civet';
import type {BenchmarkCase} from './fixtures.civet';

if (!process.argv[2]) throw new Error('Usage: pnpm bench:compare PATH_TO_REFERENCE_SRC');
const reference = resolve(process.argv[2]);
const before = await import(pathToFileURL(resolve(reference, 'index.civet')).href) as typeof after;
mkdirSync('bench/output', {recursive: true});

const cases = ['sampled', 'completed'].flatMap(suite => {
  const fixtures = JSON.parse(readFileSync(`bench/${suite}-cases.json`, 'utf8')) as BenchmarkCase[];
  return fixtures.map(c => ({name: `${c.generator.dimension}D n=${c.coordinates.length} seed=${c.generator.seed}`, points: c.coordinates, hull: {...c.hullOptions, method: 'incremental' as const}, search: c.solveOptions, full: suite === 'completed'}));
});
for (const d of [4, 5]) {
  cases.push({name: `cube ${d}D`, points: after.hypercube(d), hull: {method: 'incremental'}, search: {}, full: false});
  cases.push({name: `cross ${d}D`, points: after.crossPolytope(d), hull: {method: 'incremental'}, search: {}, full: false});
}
const versions = {before, after};
const rows: object[] = [];
for (const [index, item] of cases.entries()) {
  const hulls = {before: before.convexHull(item.points, item.hull), after: after.convexHull(item.points, item.hull)};
  // The optimized primitives preserve arithmetic order, so require exact geometry.
  assert.deepEqual(hulls.after, hulls.before, item.name);
  assert.equal(hulls.after.hullMethod, 'incremental', item.name);
  const elapsed = {before: [] as number[], after: [] as number[]};
  for (let round = 0; round < 5; round++) {
    for (const version of round % 2 ? ['after', 'before'] as const : ['before', 'after'] as const) {
      const start = performance.now();
      versions[version].convexHull(item.points, item.hull);
      elapsed[version].push(performance.now() - start);
    }
  }
  const limit = item.full ? Infinity : 80;
  const options = {...item.search, maxNodes: limit, timeoutMs: Infinity, overlapMethod: 'dual-lp' as const};
  const searches = {before: before.solve(hulls.before, options), after: after.solve(hulls.after, options)};
  assert.equal(searches.after.status, searches.before.status, item.name);
  assert.deepEqual(searches.after.tree, searches.before.tree, item.name);
  assert.deepEqual({...searches.after.stats, elapsedMs: 0}, {...searches.before.stats, elapsedMs: 0}, item.name);
  assert.deepEqual(searches.after.overlapStats, searches.before.overlapStats, item.name);
  const searchTimes = {before: [] as number[], after: [] as number[]};
  if (limit === Infinity) {
    for (let round = 0; round < 5; round++) {
      for (const version of round % 2 ? ['after', 'before'] as const : ['before', 'after'] as const) {
        const result = versions[version].solve(hulls[version], options);
        searchTimes[version].push(result.stats.elapsedMs);
      }
    }
  }
  const median = (xs: number[]): number => [...xs].sort((a, b) => a - b)[Math.floor(xs.length / 2)];
  rows.push({name: item.name, elapsed, searchTimes, beforeHullMs: median(elapsed.before), afterHullMs: median(elapsed.after), beforeSearchMs: median(searchTimes.before), afterSearchMs: median(searchTimes.after)});
  console.log(`[${index + 1}/${cases.length}] ${item.name}: hull ${(median(elapsed.before) / median(elapsed.after)).toFixed(2)}x${limit === Infinity ? ` search ${(median(searchTimes.before) / median(searchTimes.after)).toFixed(2)}x` : ''}`);
}
writeFileSync('bench/output/optimization-results.json', JSON.stringify({date: new Date().toISOString(), node: process.version, reference, rounds: 5, rows}, null, 2) + '\n');
console.log(`Exact hulls, search counts, witness trees, and overlap counters matched on all ${cases.length} cases. Results: bench/output/optimization-results.json`);
