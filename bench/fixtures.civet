type {GeneratorSpec} from ../src/jobs.civet
type {Vector} from ../src/linalg.civet
type {HullOptions, SolveOptions} from ../src/index.civet

export interface BenchmarkCase
  generator: GeneratorSpec
  coordinates: Vector[]
  hullOptions: HullOptions
  solveOptions: SolveOptions
  status: string
  savedNodes?: number
  savedMs?: number

// Store the geometry and numerical settings, without local paths or budgets.
export function benchmarkCase(generator: GeneratorSpec, coordinates: Vector[], hull: HullOptions = {}, solve: SolveOptions = {}, status = 'found', savedNodes?: number, savedMs?: number): BenchmarkCase
  {generator, coordinates, hullOptions: {hull.method, tolerance: hull.tolerance ?? 1e-9}, solveOptions: root: solve.root ?? 0, overlapTolerance: solve.overlapTolerance ?? 16 * (hull.tolerance ?? 1e-9), pruneOverlaps: solve.pruneOverlaps ?? true, stopAfterFirst: solve.stopAfterFirst ?? true, forwardCheck: solve.forwardCheck, forceBridges: solve.forceBridges, branchOrder: solve.branchOrder, status, savedNodes, savedMs}
