assert from node:assert/strict
{median} from ./util.civet
{readFileSync, writeFileSync, mkdirSync} from node:fs
{convexHull, hypercube, crossPolytope, solve} from ../src/index.civet
type {Polytope, HullMethod} from ../src/index.civet
type {BenchmarkCase} from ./fixtures.civet

fixtures := ['bench/sampled-cases.json', 'bench/completed-cases.json'].flatMap (file) => JSON.parse(readFileSync file, 'utf8') as BenchmarkCase[]
cases := fixtures.map (c) => name: `${c.generator.dimension}D n=${c.coordinates#} seed=${c.generator.seed}`, points: c.coordinates, hull: c.hullOptions, search: c.solveOptions
for d of [4, 5]
  cases.push name: `cube ${d}D`, points: hypercube(d), hull: {}, search: {}
  cases.push name: `cross ${d}D`, points: crossPolytope(d), hull: {}, search: {}
methods: HullMethod[] := ['enumerate', 'incremental']
rows: object[] := []
fallbacks .= 0

function signature(p: Polytope): object
  facets: p.facets.map(.vertices), ridges: p.ridges.map (r) => r.{facets, vertices}
for [index, item] of cases.entries()
  elapsed := enumerate: [] as number[], incremental: [] as number[]
  hulls := {} as Record<HullMethod, Polytope>
  for round of [0..<3]
    for method of round % 2 ? [...methods].reverse() : methods
      start := performance.now()
      hulls[method] = convexHull item.points, {...item.hull, method}
      elapsed[method].push performance.now() - start
  a := hulls.enumerate; b := hulls.incremental
  assert.deepEqual signature(a), signature(b), item.name
  for i of [0..<a.facets#]
    assert.ok Math.abs(a.facets[i].offset - b.facets[i].offset) < 1e-8, item.name
    assert.ok a.facets[i].normal.every((x, j) => Math.abs(x - b.facets[i].normal[j]) < 1e-8), item.name
  sa := solve(a, {...item.search, maxNodes: 80}); sb := solve b, {...item.search, maxNodes: 80}
  assert.equal sa.status, sb.status, item.name
  assert.deepEqual sa.tree, sb.tree, item.name
  assert.deepEqual {...sa.stats, elapsedMs: 0}, {...sb.stats, elapsedMs: 0}, item.name
  fallbacks++ if b.hullFallback

  enumerateMs := median(elapsed.enumerate); incrementalMs := median elapsed.incremental
  rows.push {item.name, a.dimension, points: item.points#, facets: a.facets#, enumerateMs, incrementalMs, speedup: enumerateMs / incrementalMs, elapsed, enumerateWork: a.hullCombinations, incrementalWork: b.hullCombinations, actualMethod: b.hullMethod, fallback: b.hullFallback}
  console.log `[${index + 1}/${cases#}] ${item.name}: ${enumerateMs.toFixed 2} -> ${incrementalMs.toFixed 2} ms (${(enumerateMs / incrementalMs).toFixed 2}x)`
mkdirSync 'bench/output', recursive: true
writeFileSync 'bench/output/hull-results.json', JSON.stringify({date: (new Date).toISOString(), node: process.version, rounds: 3, searchNodeLimit: 80, fallbacks, rows}, null, 2) + '\n'
console.log `${cases#} hull and search comparisons passed; ${fallbacks} fallbacks. Results: bench/output/hull-results.json`
