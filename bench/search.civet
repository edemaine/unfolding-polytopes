assert from node:assert/strict
{readFileSync, writeFileSync, mkdirSync} from node:fs
{resolve} from node:path
{pathToFileURL} from node:url
{convexHull, randomPoints, solve, developTree, interiorOverlap} from ../src/index.civet
type {SolveOptions} from ../src/index.civet
type {BenchmarkCase} from ./fixtures.civet

reference := process.argv[2] ? await import(pathToFileURL(resolve process.argv[2]).href) as {solve: typeof solve} : undefined
fixtures := JSON.parse(readFileSync 'bench/completed-cases.json', 'utf8') as BenchmarkCase[]
cases := fixtures.map (c) => name: `${c.generator.dimension}D/${c.coordinates#}/${c.generator.seed}`, points: c.coordinates, hullOptions: c.hullOptions, options: c.solveOptions
for [d, n, seed] of [[4, 9, 88516], [4, 10, 53826], [4, 11, 17273]]
  cases.push name: `${d}D/${n}/${seed}`, points: randomPoints(d, n, seed), hullOptions: {}, options: {}
methods: [string, SolveOptions][] := [
  ['bridges', forwardCheck: false, branchOrder: 'index']
  ['forward', forwardCheck: true, forceBridges: false, branchOrder: 'index']
  ['always', forwardCheck: true, branchOrder: 'index']
  ['index', forwardCheck: 'auto', branchOrder: 'index']
  ['constrained', forwardCheck: 'auto', branchOrder: 'constrained']
  ['bottleneck', forwardCheck: 'auto', branchOrder: 'bottleneck']
]
rows: object[] := []
mkdirSync 'bench/output', recursive: true
for item of cases
  poly := convexHull item.points, item.hullOptions
  verified := new Set<string>
  for round of [0..<3]
    order := [...methods[>=round], ...methods[<round]]
    order.push ['reference', {}] if reference
    for [method, extra] of order
      result := (method is 'reference' ? reference!.solve : solve) poly, {...item.options, forceBridges: true, ...extra, maxNodes: 50000, timeoutMs: 2000, overlapMethod: 'dual-lp'}
      witness := result.tree?[..].sort((a, b) => a - b).join ','
      if result.tree and not verified.has witness!
        // Check every pair, including hinges, using enumeration independently of
        // the new search's forward checks and parent shortcut. Outside timing.
        faces := developTree poly, result.tree, item.options.root ?? 0
        for (a of [0..<faces#]) for b of [0..<a]
          assert.equal interiorOverlap(faces[a], faces[b], result.overlapTolerance, undefined, 'enumerate'), false, `${item.name} ${method}`
        verified.add witness!
      rows.push {item.name, method, round, result.{status, termination, stats, overlapStats, searchOptions, searchStats}}
      console.log `${item.name} ${method} r${round}: ${result.status}, ${result.stats.nodes} nodes, ${result.stats.elapsedMs.toFixed 2}ms`
      writeFileSync 'bench/output/search-results.json', JSON.stringify {date: (new Date).toISOString(), node: process.version, maxNodes: 50000, timeoutMs: 2000, rows}, null, 2
console.log 'All returned witnesses passed enumeration overlap checks. Results: bench/output/search-results.json'
