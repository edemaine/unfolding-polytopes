assert from node:assert/strict
{writeReport} from ./report.civet
{writeFileSync, mkdirSync} from node:fs
{convexHull, randomPoints, hypercube, rootPlacement, attachFacet, interiorOverlap, solve} from ../src/index.civet
type {OverlapMethod, Placement} from ../src/index.civet

mkdirSync 'bench/output', recursive: true
methods: OverlapMethod[] := ['enumerate', 'primal-lp', 'gjk-lp', 'dual-lp']
rows: object[] := []
for [d, n, seed] of [[3, 8, 1], [4, 10, 42], [5, 10, 42], [6, 12, 196], [4, 16, -1]]
  poly := convexHull seed < 0 ? hypercube(d) : randomPoints d, n, seed, 'sphere'
  placements := new Map<number, Placement> [[0, rootPlacement poly]]
  queue := [0]
  for i .= 0; i < queue#; i++
    for ridge of poly.facets[queue[i]].ridges
      child := attachFacet poly, placements.get(queue[i])!, ridge
      unless placements.has child.facet
        placements.set child.facet, child
        queue.push child.facet

  faces := [...placements.values()]; pairs: [Placement, Placement][] := []
  // Deterministic sample spread over the complete breadth-first development.
  for (i of [0..<faces#]) for (j of [0..i]) pairs.push [faces[i], faces[j]]
  sample := pairs.filter (_, i) => i % Math.max(1, Math.floor pairs# / 200) is 0
  expected := sample.map ([a, b]) => interiorOverlap a, b, 1.6e-8, undefined, 'enumerate'
  reference := solve poly, maxNodes: 120, overlapMethod: 'enumerate'
  for round of [0..<3]
    for i of [0..<methods#]
      method := methods[(i + round) % methods#]
      stats := calls: 0, primalWitnesses: 0, supportSeparations: 0, fallbacks: 0
      start .= performance.now()
      actual := sample.map ([a, b]) => interiorOverlap a, b, 1.6e-8, undefined, method, stats
      pairMs := performance.now() - start
      assert.deepEqual actual, expected, `${d}D ${method} pair mismatch`
      result := solve poly, maxNodes: 120, overlapMethod: method
      assert.deepEqual {...result.stats, elapsedMs: 0}, {...reference.stats, elapsedMs: 0}, `${d}D ${method} search mismatch`
      assert.deepEqual result.tree, reference.tree
      rows.push {d, points: n, seed, facets: poly.facets#, method, round, pairs: sample#, overlaps: actual.filter(Boolean)#, pairMs, pairStats: stats, solveMs: result.stats.elapsedMs, result.stats.nodes, result.status, solveStats: result.overlapStats}
      console.log `${d}D n=${n} seed=${seed} ${method} round=${round}: pairs ${pairMs.toFixed 1}ms; search ${result.stats.elapsedMs.toFixed 1}ms; fallbacks ${result.overlapStats.fallbacks}/${result.overlapStats.calls}`
writeFileSync 'bench/output/results.json', JSON.stringify({date: (new Date).toISOString(), node: process.version, process.platform, note: 'Three rotated-order rounds; 120-node search cap; hull construction excluded. Other user jobs may compete for CPU.', rows}, null, 2) + '\n'
writeReport()
console.log 'All pair decisions, search counts, and witness trees match. Results: bench/output/results.json'
