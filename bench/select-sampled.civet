"civet esCompat";
import {readFileSync, readdirSync, existsSync, writeFileSync} from 'node:fs';
import {join} from 'node:path';
import {generatedInput} from '../src/jobs.civet';
import {benchmarkCase} from './fixtures.civet';
import type {GeneratorSpec} from '../src/jobs.civet';
// Read run metadata and compact journals, never scan all coordinate files.
const groups = new Map<string, {generator: GeneratorSpec; sources: string[]}>();
for (const entry of readdirSync('results', {withFileTypes: true})) {
  const source = join('results', entry.name), path = join(source, 'run.json');
  if (!entry.isDirectory() || !existsSync(path)) continue;
  const run = JSON.parse(readFileSync(path, 'utf8'));
  if (!run.generator) continue;
  const g = run.generator as GeneratorSpec;
  const key = JSON.stringify([g.family, g.dimension, g.count, g.distribution, g.scales]);
  if (!groups.has(key)) groups.set(key, {generator: g, sources: []});
  groups.get(key)!.sources.push(source);
}
const selected: object[] = [];
for (const {generator, sources} of [...groups.values()].sort((a, b) => a.generator.dimension - b.generator.dimension || a.generator.count - b.generator.count)) {
  const candidates = new Map<number, {file: string; seed: number; elapsedMs: number; status: string}>();
  for (const source of sources) {
    const journal = join(source, 'trials.jsonl');
    if (!existsSync(journal)) continue;
    for (const line of readFileSync(journal, 'utf8').split('\n')) {
      if (!line.trim()) continue;
      let row;
      try { row = JSON.parse(line); } catch { continue; }
      if (!Number.isSafeInteger(row.seed) || !['found', 'inconclusive', 'no-unfolding'].includes(row.status)) continue;
      const file = join(source, row.file);
      const old = candidates.get(row.seed);
      if (!old || (row.elapsedMs ?? 0) > old.elapsedMs) candidates.set(row.seed, {file, seed: row.seed, elapsedMs: row.elapsedMs ?? 0, status: row.status});
    }
  }
  const rows = [...candidates.values()].sort((a, b) => a.seed - b.seed);
  const hard = [...rows].sort((a, b) => Number(b.status === 'inconclusive') - Number(a.status === 'inconclusive') || b.elapsedMs - a.elapsedMs)[0];
  const picks = [rows[0], rows[Math.floor(rows.length / 2)], hard].filter(Boolean);
  const unique = [...new Map(picks.map(row => [row.seed, row])).values()];
  if (!unique.length) {
    for (let seed = generator.seed; seed < generator.seed + 3; seed++) {
      const g = {...generator, seed};
      selected.push(benchmarkCase(g, generatedInput(g).points, {}, {}, 'planned-unfinished'));
    }
  }
  for (const row of unique) {
    const saved = JSON.parse(readFileSync(row.file, 'utf8'));
    selected.push(benchmarkCase({...generator, seed: row.seed}, saved.points, saved.hullOptions, {...saved.solveOptions, overlapTolerance: saved.result?.overlapTolerance}, row.status, saved.result?.stats?.nodes, row.elapsedMs));
  }
  console.log(`${generator.dimension}D n=${generator.count}: ${rows.length} recorded seeds; selected ${unique.map(r => r.seed).join(', ')}`);
}
writeFileSync('bench/sampled-cases.json', JSON.stringify(selected, null, 2) + '\n');
console.log('Cases saved to bench/sampled-cases.json');
