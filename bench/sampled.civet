assert from node:assert/strict
{readFileSync, writeFileSync, mkdirSync} from node:fs
{convexHull, rootPlacement, attachFacet, interiorOverlap, overlapMethods, solve} from ../src/index.civet
type {Placement, SolveOptions} from ../src/index.civet
type {BenchmarkCase} from ./fixtures.civet
{randomSource} from ../src/generators.civet
{dot} from ../src/linalg.civet

mkdirSync 'bench/output', recursive: true
cases := JSON.parse(readFileSync process.argv[2] ?? 'bench/sampled-cases.json', 'utf8') as BenchmarkCase[]
rows: object[] := []; failures: object[] := []
pairComparisons .= 0; searchComparisons .= 0
output := 'bench/output/sampled-results.json'
start := performance.now()
function save(): void
  writeFileSync output, JSON.stringify({date: (new Date).toISOString(), node: process.version, cases, pairComparisons, searchComparisons, elapsedMs: performance.now() - start, failures, rows}, null, 2) + '\n'

function mismatch(context: object, a: Placement, b: Placement, tolerance: number, expected: boolean, actual: boolean): void
  file := `bench/output/sampled-failures/pair-${failures#}.json`
  mkdirSync 'bench/output/sampled-failures', recursive: true
  writeFileSync file, JSON.stringify {context, a, b, tolerance, expected, actual}, null, 2
  failures.push {context, file, expected, actual}

for each item, index of cases
  {dimension: d, count: n, seed} := item.generator
  console.log `[${index + 1}/${cases#}] ${d}D n=${n} seed=${seed} (${item.status})`
  poly := convexHull item.coordinates, item.hullOptions
  tolerance := item.solveOptions.overlapTolerance ?? 16 * poly.tolerance
  pairs: [Placement, Placement][] := []
  random := randomSource seed
  for tree of [0..<2]
    root := tree is 0 ? 0 : Math.floor random() * poly.facets#
    placed := new Map<number, Placement>([[root, rootPlacement poly, root]]); queue := [root]
    for i .= 0; i < queue#; i++
      edges := [...poly.facets[queue[i]].ridges]
      for j of [edges#>..>0]
        k := Math.floor random() * (j + 1)
        [edges[j], edges[k]] = [edges[k], edges[j]]

      for ridge of edges
        parent := placed.get(queue[i])!; childId := poly.ridges[ridge].facets.find((f) => f is not parent.facet)!
        continue if placed.has childId
        child := attachFacet poly, parent, ridge
        placed.set(childId, child); queue.push childId
        pairs.push [parent, child] if pairs# < 24 * (tree + 1)
    faces := [...placed.values()]
    for (i of [0..<96]) pairs.push [faces[Math.floor random() * faces#], faces[Math.floor random() * faces#]]
  expected := pairs.map ([a, b]) => interiorOverlap a, b, tolerance, undefined, 'enumerate'
  options: SolveOptions := {...item.solveOptions, maxNodes: 40, overlapTolerance: tolerance}
  reference := solve poly, {...options, overlapMethod: 'enumerate'}
  for round of [0..<2]
    for offset of [0..<overlapMethods#]
      method := overlapMethods[(offset + index + round * 5) % overlapMethods#]
      stats := calls: 0, primalWitnesses: 0, supportSeparations: 0, fallbacks: 0
      before := performance.now()
      for each [a, b], i of pairs
        actual := interiorOverlap a, b, tolerance, undefined, method, stats
        pairComparisons++ if method is not 'enumerate'
        mismatch {index, method, round, i}, a, b, tolerance, expected[i], actual if actual is not expected[i]
      pairMs := performance.now() - before
      result := solve poly, {...options, overlapMethod: method}
      try
        assert.deepEqual {...result.stats, elapsedMs: 0}, {...reference.stats, elapsedMs: 0}
        assert.deepEqual result.tree, reference.tree
        assert.equal result.status, reference.status
        assert.equal result.termination, reference.termination
      catch (error)
        failures.push {index, method, round, kind: 'search', result, reference, error: String error}

      searchComparisons++ if method is not 'enumerate'
      rows.push {index, d, points: n, seed, facets: poly.facets#, method, round, pairs: pairs#, overlaps: expected.filter(Boolean)#, pairMs, pairStats: stats, solveMs: result.stats.elapsedMs, solveStats: result.overlapStats, result.stats.nodes, result.status}
  save()
  console.log `  ${poly.facets#} facets; ${pairs#} pairs (${expected.filter(Boolean)#} overlapping); ${reference.stats.nodes} nodes; ${failures#} disagreements`

// Rotated boxes ensure near-contact checks cannot usually stop at the AABB.
// Analytic answer: two equal boxes translated along their first local axis
// have common inradius gap/2, where gap is their overlap in that axis.
for k of [1..5]
  function rotate(p: number[]): number[]
    q := [...p]
    for j of [1..<k]
      x := q[0]
      y := q[j]
      angle := .37 + .11 * j
      q[0] = Math.cos(angle) * x - Math.sin(angle) * y
      q[j] = Math.sin(angle) * x + Math.cos(angle) * y

    q
  function box(shift: number): Placement
    translation := rotate Array.from length: k, (_, j) => j is 0 ? shift : 0
    coordinates := Array.from length: 2 ** k, (_, mask) => rotate(Array.from length: k, (_, j) => mask & 2 ** j ? 1 : -1).map (x, j) => x + translation[j]
    halfspaces := Array.from length: 2 * k, (_, i) =>
      normal := rotate Array.from {length: k}, (_, j) => j is Math.floor(i / 2) ? i % 2 ? 1 : -1 : 0
      {normal, offset: 1 + dot normal, translation}

    {facet: 0, linear: [], translation, vertices: coordinates.map((_, i) => i), coordinates, halfspaces, min: coordinates[0].map((_, j) => Math.min ...coordinates.map (p) => p[j]), max: coordinates[0].map (_, j) => Math.max ...coordinates.map (p) => p[j]}
  for tolerance of [1e-10, 1.6e-8, 1e-6]
    for depth of [-4, 0, 1, 1.9, 2.1, 4]
      a := box(0); b := box(2 - depth * tolerance); analytic := depth > 2
      for method of overlapMethods
        actual := interiorOverlap a, b, tolerance, undefined, method
        pairComparisons++
        mismatch {kind: 'analytic-box', k, depth, method}, a, b, tolerance, analytic, actual if actual is not analytic
  console.log `Analytic rotated boxes in ${k} dimensions checked; ${failures#} disagreements`
save()
console.log `${pairComparisons} pair comparisons; ${searchComparisons} search comparisons; ${failures#} disagreements. Results: ${output}`
process.exitCode = 1 if failures#
