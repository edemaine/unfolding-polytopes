assert from node:assert/strict
{readFileSync, writeFileSync, mkdirSync} from node:fs
{Session} from node:inspector/promises
{convexHull, solve} from ../src/index.civet
type {OverlapMethod, SolveOptions} from ../src/index.civet

type {BenchmarkCase} from ./fixtures.civet
mkdirSync 'bench/output', recursive: true
cases := JSON.parse(readFileSync 'bench/completed-cases.json', 'utf8') as BenchmarkCase[]
prepared := cases.map (item) =>
  start := performance.now()
  hullOptions := item.hullOptions
  poly := convexHull item.coordinates, hullOptions
  hullMs := performance.now() - start
  options: SolveOptions := {...item.solveOptions, maxNodes: Infinity, timeoutMs: Infinity}
  {item, poly, options, hullOptions, hullMs}

rows: object[] := []
for {item, poly, options, hullMs} of prepared
  console.log `${item.generator.dimension}D/${item.generator.count} seed ${item.generator.seed}, saved ${item.savedNodes} nodes`
  let reference: ReturnType<typeof solve>?
  for round of [0..<3]
    methods: OverlapMethod[] := round % 2 ? ['dual-lp', 'enumerate'] : ['enumerate', 'dual-lp']
    for method of methods
      result := solve poly, {...options, overlapMethod: method}
      assert.equal result.status, 'found'
      assert.equal result.termination, 'solution'
      reference = result unless reference
      assert.deepEqual {...result.stats, elapsedMs: 0}, {...reference.stats, elapsedMs: 0}
      assert.deepEqual result.tree, reference.tree
      rows.push {item.generator.dimension, points: item.generator.count, item.generator.seed, method, round, hullMs, searchMs: result.stats.elapsedMs, result.{stats, overlapStats}}
      console.log `  ${method}: ${result.stats.elapsedMs.toFixed 2}ms, ${result.stats.nodes} nodes`
  writeFileSync 'bench/output/completed-results.json', JSON.stringify {date: (new Date).toISOString(), node: process.version, rows}, null, 2

// Profile only warmed work: imports and input reads are outside both profiles.
session := new Session; session.connect()
await session.post 'Profiler.enable'
await session.post 'Profiler.setSamplingInterval', interval: 1000
for mode of ['search', 'pipeline']
  await session.post 'Profiler.start'
  start := performance.now()
  solves .= 0
  while performance.now() - start < 6000
    for {item, poly, options, hullOptions} of prepared
      input := mode is 'pipeline' ? convexHull(item.coordinates, hullOptions) : poly
      result := solve input, {...options, overlapMethod: 'dual-lp'}
      assert.equal(result.status, 'found'); solves++
  {profile} := await session.post 'Profiler.stop'
  writeFileSync `bench/output/completed-${mode}.cpuprofile`, JSON.stringify profile
  console.log `Profiled ${solves} full ${mode} solves in ${(performance.now() - start).toFixed 0}ms`
session.disconnect()
console.log 'All full searches matched. Results saved to bench/output/'
